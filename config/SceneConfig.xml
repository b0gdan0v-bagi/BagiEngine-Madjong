<?xml version="1.0"?>
<SceneManager>
  <scenes>
    <!--
      The one scene of the game (MahjongGame::GetSceneName()). The view is the design size of the table (kViewWidth x kViewHeight in
      Table/TableLayout.h; MahjongTableUiTest compares the two) and the engine fits it to the window. MahjongTableComponent draws the
      felt, the four hands, the melds, the discards and the wall of the active game, plays the person seats and paces the computers.
      Its buttons are the canvases below; the component shows and hides them from the legal actions (Table/ActionButtons.h) and answers
      their actions. MahjongHudComponent publishes the words of the HUD (UIVars), runs the seat choice (the modal canvas Setup) and
      shows the score table of a finished hand (HandOver) and the standings of a finished match (MatchOver).
      The nodes are in config/nodes/, one file per node named Mahjong<Name>; the order of the references below is the draw and input
      order (the engine replaces each reference by the node of its file in the same place).
    -->
    <scene
      type="Scene"
      name="MahjongScene"
      viewWidth="1280"
      viewHeight="720">
      <nodes>
        <node ref="nodes/MahjongTable"/>
        <node ref="nodes/MahjongHints"/>
        <node ref="nodes/MahjongHintsButton"/>
        <node ref="nodes/MahjongActions"/>
        <node ref="nodes/MahjongActionsCompact"/>
        <node ref="nodes/MahjongHud"/>
        <node ref="nodes/MahjongSeatPlates"/>
        <node ref="nodes/MahjongHudMenu"/>
        <node ref="nodes/MahjongHandoff"/>
        <node ref="nodes/MahjongHandOver"/>
        <node ref="nodes/MahjongHandOverAction"/>
        <node ref="nodes/MahjongMatchOver"/>
        <node ref="nodes/MahjongSetup"/>
        <node ref="nodes/MahjongOptions"/>
        <node ref="nodes/MahjongRules"/>
        <node ref="nodes/MahjongRulesAction"/>
      </nodes>
    </scene>
  </scenes>
</SceneManager>
