<?xml version="1.0"?>
<SceneManager>
  <scenes>
    <!--
      The one scene of the game (MahjongGame::GetSceneName()). The view is the design size of the table (kViewWidth x kViewHeight in
      Table/TableLayout.h; MahjongTableUiTest compares the two) and the engine fits it to the window. MahjongTableComponent draws the
      felt, the four hands, the melds, the discards and the wall of the active game, plays the person seats and paces the computers.
      Its buttons are the canvases below; the component shows and hides them from the legal actions (Table/ActionButtons.h) and answers
      their actions. MahjongHudComponent publishes the words of the HUD (UIVars), runs the seat choice (the modal canvas Setup) and
      shows the score table of a finished hand (HandOver) and the standings of a finished match (MatchOver).
    -->
    <scene
      type="Scene"
      name="MahjongScene"
      viewWidth="1280"
      viewHeight="720">
      <nodes>
        <node name="Table">
          <components>
            <component type="MahjongTableComponent" />
          </components>
        </node>
        <!--
          The hints (Table/Hints.h, MahjongHintsComponent). The component answers the row HintsRow of Setup (MahjongSetHints) and the
          button HintButton (MahjongHintAdvice), fills the canvas below and draws the marks over the viewer's hand; it comes after the
          table (layer 5: it reads the layout the table drew) and before the canvas so that the variables are set when the canvas draws.
          The canvas lies on the view of the table (SceneView, ignoreSafeArea: like the table it is a fixed design) in the free ground
          inside the wall ring, x 472..808 and y 284..420 (the ring is 26 x 12 stacks of 14 units at y 268, TableLayout.h, and its inside
          is x 472..808, y 282..422: the canvas keeps to the grid of 4; MahjongHintsTest checks the rectangles against the worst-case
          layout). The top 80 units are the waiting row WaitPanel (a scrim plate): the caption (24, font 18) and a cell per tile that the
          viewer's hand waits for (WaitCell0..12, 24 x 56: the tile as a UIImage of 24 x 32 whose sprite Tile_<notation> the component
          sets, and under it the count of the copies the viewer cannot see, {hintCountN}, 24 high, font 18). The caption, the counts and
          the sentence are AutoFit: at 18 they fill their lines in a window of 1280 x 720 and shrink in the smallest windows, where a line
          of 18 units is taller than the 24 the row has. The strip y 364..420 below it (56 units: a touch target of 20 px in the smallest
          window) holds the button HintButton (neutral, the only element that takes input) and the label AdviceText (a scrim plate)
          with the sentence {hintAdvice} of the advice. All start hidden; the component shows the panel and the first N cells exactly
          while hints apply (MahjongGame::HintsOn(), a person at the table, no cover, no Setup, the hand being played) and the hand
          waits, the button while hints apply and the viewer has actions to choose from, and the label while an advice is up.
        -->
        <node name="Hints" layer="5">
          <components>
            <component type="MahjongHintsComponent" />
            <component type="UICanvasComponent" space="SceneView" useSafeArea="true">
              <elements>
                <element type="UIStack" name="WaitPanel" anchor="TopLeft" ignoreSafeArea="true" visible="false" x="472" y="284" width="336" height="80" direction="Vertical" spacing="0" padding="0" crossAlign="Center" color="0,0,0,200">
                  <children>
                    <element type="UILabel" name="WaitCaption" width="336" height="24" text="{#hints.waitCaption}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                    <element type="UIStack" name="WaitRow" width="312" height="56" direction="Horizontal" spacing="0" crossAlign="Start">
                      <children>
                        <element type="UIStack" name="WaitCell0" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile0" height="32" />
                            <element type="UILabel" name="WaitCount0" height="24" text="{hintCount0}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell1" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile1" height="32" />
                            <element type="UILabel" name="WaitCount1" height="24" text="{hintCount1}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell2" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile2" height="32" />
                            <element type="UILabel" name="WaitCount2" height="24" text="{hintCount2}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell3" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile3" height="32" />
                            <element type="UILabel" name="WaitCount3" height="24" text="{hintCount3}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell4" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile4" height="32" />
                            <element type="UILabel" name="WaitCount4" height="24" text="{hintCount4}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell5" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile5" height="32" />
                            <element type="UILabel" name="WaitCount5" height="24" text="{hintCount5}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell6" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile6" height="32" />
                            <element type="UILabel" name="WaitCount6" height="24" text="{hintCount6}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell7" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile7" height="32" />
                            <element type="UILabel" name="WaitCount7" height="24" text="{hintCount7}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell8" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile8" height="32" />
                            <element type="UILabel" name="WaitCount8" height="24" text="{hintCount8}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell9" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile9" height="32" />
                            <element type="UILabel" name="WaitCount9" height="24" text="{hintCount9}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell10" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile10" height="32" />
                            <element type="UILabel" name="WaitCount10" height="24" text="{hintCount10}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell11" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile11" height="32" />
                            <element type="UILabel" name="WaitCount11" height="24" text="{hintCount11}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                        <element type="UIStack" name="WaitCell12" visible="false" width="24" height="56" direction="Vertical" crossAlign="Stretch">
                          <children>
                            <element type="UIImage" name="WaitTile12" height="32" />
                            <element type="UILabel" name="WaitCount12" height="24" text="{hintCount12}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
                          </children>
                        </element>
                      </children>
                    </element>
                  </children>
                </element>
                <element type="UIButton" name="HintButton" anchor="TopLeft" ignoreSafeArea="true" visible="false" x="472" y="364" width="120" height="56" text="{#hints.adviseButton}" fontSize="22" action="MahjongHintAdvice" color="70,70,100,255" />
                <element type="UILabel" name="AdviceText" anchor="TopLeft" ignoreSafeArea="true" visible="false" x="596" y="364" width="212" height="56" text="{hintAdvice}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" color="0,0,0,200" />
              </elements>
            </component>
          </components>
        </node>
        <!--
          The action buttons lie in the free corner of the table, right of the bottom discards and above the viewer's melds (see
          Table/TableLayout.cpp); three rows of three, laid out against the whole view (ignoreSafeArea) like the table. They start hidden: the
          component shows the ones the person to act can press. A button says what it does in a plain word (Table/ActionButtons.h, ButtonSpec::wordKey:
          the keys button.<Kind> of config/UIStrings.xml) and, where it concerns tiles, shows them as pictures: a UIImage child NameTile0..2 on the bottom line (the three tiles of
          a chow, the claimed discard of a pung, kong or mahjong, the tile of a concealed kong or of the upgrade), hidden until the component sets
          its sprite (Tile_<notation> of TextureLibrary.xml) and shows it; a picture takes no input, so a click on it is a click on the button.
          A button is 56 view units high, which is a 32 px touch target from a window of 731 x 411 px; the table is a fixed design that the
          engine scales to the window, so a smaller window has smaller buttons and tiles (a tile is 21 x 28 units, the 3:4 of an atlas cell).
          The label Hint above the row shows the sentence of the button under the pointer ({actionHint}, set by the component in the
          current language from UIElement::hovered and again when the language changes; hidden while there is none). It takes no input, so
          it never eats a click; it lies in the gutter between the wall and the right seat's discards (x 832..1028, y 256..452: 196 square,
          room for the longer words of a translation; clear of their plates and of the row it explains, MahjongTableScreenTest holds the
          place). A touch screen has no hover.
        -->
        <node name="Actions" layer="10">
          <components>
            <component type="UICanvasComponent" space="SceneView" useSafeArea="true">
              <elements>
                <element type="UILabel" name="Hint" anchor="TopLeft" ignoreSafeArea="true" visible="false" x="832" y="256" width="196" height="196" text="{actionHint}" fontSize="18" align="Center" verticalAlign="Center" color="0,0,0,200" />
                <element type="UIStack" name="ActionRow" anchor="TopLeft" ignoreSafeArea="true" x="724" y="460" width="412" height="184" direction="Horizontal" spacing="8" wrapChildren="true">
                  <children>
                  <element type="UIButton" name="Win" visible="false" width="132" height="56" text="{#button.Win}" fontSize="22" action="MahjongWin" color="40,110,60,255" />
                  <element type="UIButton" name="Mahjong" visible="false" width="132" height="56" text="{#button.ClaimMahjong}" fontSize="18" verticalAlign="Top" action="MahjongClaimMahjong" color="40,110,60,255">
                    <children>
                      <element type="UIImage" name="MahjongTile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
                    </children>
                  </element>
                  <element type="UIButton" name="Pung" visible="false" width="132" height="56" text="{#button.ClaimPung}" fontSize="18" verticalAlign="Top" action="MahjongClaimPung" color="45,75,120,255">
                    <children>
                      <element type="UIImage" name="PungTile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
                    </children>
                  </element>
                  <element type="UIButton" name="Kong" visible="false" width="132" height="56" text="{#button.ClaimKong}" fontSize="18" verticalAlign="Top" action="MahjongClaimKong" color="45,75,120,255">
                    <children>
                      <element type="UIImage" name="KongTile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
                    </children>
                  </element>
                  <element type="UIButton" name="Chow0" visible="false" width="132" height="56" text="{#button.ClaimChow0}" fontSize="18" verticalAlign="Top" action="MahjongClaimChow" value="0" color="45,75,120,255">
                    <children>
                      <element type="UIImage" name="Chow0Tile0" visible="false" anchor="Bottom" x="-23" y="-3" width="21" height="28" />
                      <element type="UIImage" name="Chow0Tile1" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
                      <element type="UIImage" name="Chow0Tile2" visible="false" anchor="Bottom" x="23" y="-3" width="21" height="28" />
                    </children>
                  </element>
                  <element type="UIButton" name="Chow1" visible="false" width="132" height="56" text="{#button.ClaimChow1}" fontSize="18" verticalAlign="Top" action="MahjongClaimChow" value="1" color="45,75,120,255">
                    <children>
                      <element type="UIImage" name="Chow1Tile0" visible="false" anchor="Bottom" x="-23" y="-3" width="21" height="28" />
                      <element type="UIImage" name="Chow1Tile1" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
                      <element type="UIImage" name="Chow1Tile2" visible="false" anchor="Bottom" x="23" y="-3" width="21" height="28" />
                    </children>
                  </element>
                  <element type="UIButton" name="Chow2" visible="false" width="132" height="56" text="{#button.ClaimChow2}" fontSize="18" verticalAlign="Top" action="MahjongClaimChow" value="2" color="45,75,120,255">
                    <children>
                      <element type="UIImage" name="Chow2Tile0" visible="false" anchor="Bottom" x="-23" y="-3" width="21" height="28" />
                      <element type="UIImage" name="Chow2Tile1" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
                      <element type="UIImage" name="Chow2Tile2" visible="false" anchor="Bottom" x="23" y="-3" width="21" height="28" />
                    </children>
                  </element>
                  <element type="UIButton" name="ConcealedKong0" visible="false" width="132" height="56" text="{#button.ConcealedKong0}" fontSize="18" verticalAlign="Top" action="MahjongConcealedKong" value="0" color="70,70,100,255">
                    <children>
                      <element type="UIImage" name="ConcealedKong0Tile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
                    </children>
                  </element>
                  <element type="UIButton" name="ConcealedKong1" visible="false" width="132" height="56" text="{#button.ConcealedKong1}" fontSize="18" verticalAlign="Top" action="MahjongConcealedKong" value="1" color="70,70,100,255">
                    <children>
                      <element type="UIImage" name="ConcealedKong1Tile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
                    </children>
                  </element>
                  <element type="UIButton" name="ConcealedKong2" visible="false" width="132" height="56" text="{#button.ConcealedKong2}" fontSize="18" verticalAlign="Top" action="MahjongConcealedKong" value="2" color="70,70,100,255">
                    <children>
                      <element type="UIImage" name="ConcealedKong2Tile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
                    </children>
                  </element>
                  <element type="UIButton" name="UpgradeKong" visible="false" width="132" height="56" text="{#button.UpgradeKong}" fontSize="18" verticalAlign="Top" action="MahjongUpgradeKong" color="70,70,100,255">
                    <children>
                      <element type="UIImage" name="UpgradeKongTile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
                    </children>
                  </element>
                  <element type="UIButton" name="Pass" visible="false" width="132" height="56" text="{#button.Pass}" fontSize="22" action="MahjongPass" color="90,50,50,255" />
                  <element type="UIToggle" name="Declare" visible="false" bind="declareNext" onValue="on" offValue="off" width="180" height="56" text="{#button.Declare}" fontSize="22" action="MahjongDeclare" color="70,70,100,255" />
                  </children>
                </element>
              </elements>
            </component>
          </components>
        </node>
        <!--
          The HUD lies in the free parts of the table (Table/TableLayout.cpp): the round, the wall and the turn above the left column of melds, the New game
          button in the top right one, the four scores on the free ground between the top hand and the left column. It keeps to the safe area
          (the table is a fixed design that the safe area does not move), so on a screen with a notch or side insets it moves inwards and can
          cover the nearest tiles. MahjongHudComponent publishes round, hand, handsTotal, wall, turn and, per seat, seatName, seatWind,
          seatScore, seatMark (the seat whose turn it is) and seatDealer (East). MahjongHudTest holds the worst texts and checks that no tile of any
          game lies under it.
        -->
        <node name="Hud" layer="10">
          <components>
            <component type="MahjongHudComponent" />
            <component type="UICanvasComponent" space="SceneView" useSafeArea="true">
              <elements>
                <element type="UIStack" name="Info" anchor="TopLeft" x="96" y="8" width="336" height="112" direction="Vertical" padding="8" crossAlign="Stretch" color="10,30,22,170">
                  <children>
                    <element type="UILabel" name="RoundLabel" height="32" text="{#hud.round}" fontSize="22" />
                    <element type="UILabel" name="WallLabel" height="32" text="{#hud.wall}" fontSize="22" />
                    <element type="UILabel" name="TurnLabel" height="32" text="{#hud.turn}" fontSize="22" />
                  </children>
                </element>
                <element type="UIStack" name="Scores" anchor="TopLeft" x="96" y="128" width="336" height="144" direction="Vertical" padding="8" crossAlign="Stretch" color="10,30,22,170">
                  <children>
                    <element type="UILabel" name="Score0" height="32" text="{seatMark0}{seatName0}{seatDealer0}: {seatScore0}" fontSize="22" />
                    <element type="UILabel" name="Score1" height="32" text="{seatMark1}{seatName1}{seatDealer1}: {seatScore1}" fontSize="22" />
                    <element type="UILabel" name="Score2" height="32" text="{seatMark2}{seatName2}{seatDealer2}: {seatScore2}" fontSize="22" />
                    <element type="UILabel" name="Score3" height="32" text="{seatMark3}{seatName3}{seatDealer3}: {seatScore3}" fontSize="22" />
                  </children>
                </element>
                <element type="UIButton" name="NewGame" anchor="TopRight" x="-8" y="8" width="176" height="56" text="{#hud.newGame}" fontSize="22" action="MahjongNewGame" color="45,75,120,255" />
              </elements>
            </component>
          </components>
        </node>
        <!-- The cover of a hot seat: shown by the component exactly while the screen waits for the next person (HandoffPending). A Screen canvas that keeps its buttons touch targets in any window. -->
        <node name="Handoff" layer="20">
          <components>
            <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.7" useSafeArea="true" modal="true" visible="false">
              <elements>
                <element type="UIElement" name="Dim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,200" blocksInput="true" />
                <element type="UIStack" name="Plate" anchor="Center" width="94%" maxWidth="560" height="208" direction="Vertical" spacing="16" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
                  <children>
                    <element type="UILabel" name="HandoffText" height="96" text="{#cover.text}" fontSize="28" align="Center" verticalAlign="Center" color="58,66,92,255" />
                    <element type="UIButton" name="Reveal" height="64" text="{#cover.show}" fontSize="28" action="MahjongReveal" color="40,110,60,255" />
                  </children>
                </element>
              </elements>
            </component>
          </components>
        </node>
        <!--
          The score table of a finished hand: a modal canvas on the view of the table (SceneView like Setup: 16 lines of the winner, four
          seats, a headline and a button are 668 units, which a Screen canvas would not fit in a 480 px window at the user scale 1.5),
          shown by MahjongHudComponent exactly while the session is in HandOver. The component publishes handOverHeadline,
          handOverSeat0..3, scoreLine0..15 (only the first lines of the winner are shown: ScoreLineN is visible when there is a line N),
          handOverSummary and handOverButton ("Next hand", "Finish match" on the last hand); MahjongNextHand settles the hand and deals on.
          The plate is 32 padding + 80 headline band (two lines of 28 for the longest headline) + 4 x 32 seat rows + 252 lines (8 rows of 28
          with 4 between) + 48 summary band + 64 button + 8 x 8 spacing (9 children: NextGap is empty, so the 8 + 8 round it set the button
          16 apart from the summary) = 668 units of the 720 of the view.
        -->
        <node name="HandOver" layer="25">
          <components>
            <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
              <elements>
                <element type="UIElement" name="Dim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,200" blocksInput="true" />
                <element type="UIStack" name="Plate" anchor="Center" width="94%" maxWidth="640" height="668" direction="Vertical" spacing="8" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
                  <children>
                    <element type="UILabel" name="Headline" height="80" text="{handOverHeadline}" fontSize="28" align="Center" verticalAlign="Center" color="58,66,92,255" />
                    <element type="UILabel" name="SeatRow0" height="32" text="{handOverSeat0}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
                    <element type="UILabel" name="SeatRow1" height="32" text="{handOverSeat1}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
                    <element type="UILabel" name="SeatRow2" height="32" text="{handOverSeat2}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
                    <element type="UILabel" name="SeatRow3" height="32" text="{handOverSeat3}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
                    <element type="UIStack" name="Lines" height="252" direction="Horizontal" spacing="4" wrapChildren="true">
                      <children>
                        <element type="UILabel" name="ScoreLine0" visible="false" width="49%" height="28" text="{scoreLine0}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine1" visible="false" width="49%" height="28" text="{scoreLine1}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine2" visible="false" width="49%" height="28" text="{scoreLine2}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine3" visible="false" width="49%" height="28" text="{scoreLine3}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine4" visible="false" width="49%" height="28" text="{scoreLine4}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine5" visible="false" width="49%" height="28" text="{scoreLine5}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine6" visible="false" width="49%" height="28" text="{scoreLine6}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine7" visible="false" width="49%" height="28" text="{scoreLine7}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine8" visible="false" width="49%" height="28" text="{scoreLine8}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine9" visible="false" width="49%" height="28" text="{scoreLine9}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine10" visible="false" width="49%" height="28" text="{scoreLine10}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine11" visible="false" width="49%" height="28" text="{scoreLine11}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine12" visible="false" width="49%" height="28" text="{scoreLine12}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine13" visible="false" width="49%" height="28" text="{scoreLine13}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine14" visible="false" width="49%" height="28" text="{scoreLine14}" fontSize="18" />
                        <element type="UILabel" name="ScoreLine15" visible="false" width="49%" height="28" text="{scoreLine15}" fontSize="18" />
                      </children>
                    </element>
                    <element type="UILabel" name="Summary" height="48" text="{handOverSummary}" fontSize="18" align="Center" verticalAlign="Center" color="48,54,72,255" textColor="190,196,190,255" />
                    <element type="UIElement" name="NextGap" height="0" />
                    <element type="UIButton" name="NextHand" height="64" text="{handOverButton}" fontSize="28" action="MahjongNextHand" color="40,110,60,255" />
                  </children>
                </element>
              </elements>
            </component>
          </components>
        </node>
        <!--
          The end of the match: the seats by points and the New game button (MahjongNewGame, which opens Setup), shown while the match is Finished.
          A 480 px window at the user scale 1.5 is 320 units high (296 with a notch), so the plate is 296: 32 padding + 40 headline band +
          4 x 32 rows + 64 button + 8 NewGameGap + 6 x 4 spacing (7 children: the rows lie 4 apart and the button 4 + 8 + 4 = 16 below them).
        -->
        <node name="MatchOver" layer="25">
          <components>
            <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.7" useSafeArea="true" modal="true" visible="false">
              <elements>
                <element type="UIElement" name="Dim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,200" blocksInput="true" />
                <element type="UIStack" name="Plate" anchor="Center" width="94%" maxWidth="560" height="296" direction="Vertical" spacing="4" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
                  <children>
                    <element type="UILabel" name="Headline" height="40" text="{matchOverHeadline}" fontSize="22" align="Center" verticalAlign="Center" color="58,66,92,255" />
                    <element type="UILabel" name="Standing0" height="32" text="{standing0}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" textColor="255,214,80,255" />
                    <element type="UILabel" name="Standing1" height="32" text="{standing1}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
                    <element type="UILabel" name="Standing2" height="32" text="{standing2}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
                    <element type="UILabel" name="Standing3" height="32" text="{standing3}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
                    <element type="UIElement" name="NewGameGap" height="8" />
                    <element type="UIButton" name="NewGame" height="64" text="{#matchover.newGame}" fontSize="28" action="MahjongNewGame" color="40,110,60,255" />
                  </children>
                </element>
              </elements>
            </component>
          </components>
        </node>
        <!--
          The seat choice of a new game: a modal canvas on the view of the table (SceneView, like the buttons: a Screen canvas would have to
          fit a 320 unit wide window at the user scale 1.5 of the size matrix), hidden here; MahjongHudComponent shows it exactly while
          MahjongGame::IsSetupOpen() (at the start, and after the New game button). Each seat group carries action MahjongSetSeatN and the
          value person or computer; the row HandsRow below them carries MahjongSetHands and the value 16 or 8, the row HintsRow
          MahjongSetHints and the value on or off (MahjongHintsComponent, variable hintsChoice; it takes effect at once, no Start
          needed), the row LanguageRow above them MahjongSetLanguage (value = the language id, variable language). The variables
          seatKindN, handsChoice and language are set by the component, which also begins the match on MahjongStart. The plate is
          32 padding + 48 title band + 7 x 64 rows (4 padding round a 56 segment) + 64 Start + 9 x 8 spacing (10 children: StartGap is
          empty, so the 8 + 8 round it set Start 16 apart from the rows) = 664 units of the 720 of the view (the notch of the size matrix leaves 669 at most).
        -->
        <node name="Setup" layer="30">
          <components>
            <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
              <elements>
                <element type="UIElement" name="Dim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,200" blocksInput="true" />
                <element type="UIStack" name="Plate" anchor="Center" width="94%" maxWidth="640" height="664" direction="Vertical" spacing="8" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
                  <children>
                    <element type="UILabel" name="Title" height="48" text="{#setup.title}" fontSize="28" align="Center" verticalAlign="Center" color="58,66,92,255" />
                    <element type="UIStack" name="LanguageRow" height="64" direction="Horizontal" spacing="8" padding="4" crossAlign="Stretch" color="48,54,72,255">
                      <children>
                        <element type="UILabel" name="LanguageCaption" width="112" height="56" text="{#setup.language}" fontSize="22" verticalAlign="Center" textColor="190,196,190,255" />
                        <element type="UISegmented" name="Language" bind="language" flex="1" height="56" direction="Horizontal" spacing="4" color="48,54,72,255">
                          <children>
                            <element type="UIButton" name="LanguageEn" flex="1" height="56" text="{#lang.en}" fontSize="22" action="MahjongSetLanguage" value="en" color="70,70,100,255" selectedColor="40,110,60,255" />
                            <element type="UIButton" name="LanguageRu" flex="1" height="56" text="{#lang.ru}" fontSize="22" action="MahjongSetLanguage" value="ru" color="70,70,100,255" selectedColor="40,110,60,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UIStack" name="SeatRow0" height="64" direction="Horizontal" spacing="8" padding="4" crossAlign="Stretch" color="48,54,72,255">
                      <children>
                        <element type="UILabel" name="SeatCaption0" width="112" height="56" text="{#setup.seat1}" fontSize="22" verticalAlign="Center" textColor="190,196,190,255" />
                        <element type="UISegmented" name="SeatKind0" bind="seatKind0" flex="1" height="56" direction="Horizontal" spacing="4" color="48,54,72,255">
                          <children>
                            <element type="UIButton" name="Seat0Person" flex="1" height="56" text="{#setup.person}" fontSize="22" action="MahjongSetSeat0" value="person" color="70,70,100,255" selectedColor="40,110,60,255" />
                            <element type="UIButton" name="Seat0Computer" flex="1" height="56" text="{#setup.computer}" fontSize="22" action="MahjongSetSeat0" value="computer" color="70,70,100,255" selectedColor="40,110,60,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UIStack" name="SeatRow1" height="64" direction="Horizontal" spacing="8" padding="4" crossAlign="Stretch" color="48,54,72,255">
                      <children>
                        <element type="UILabel" name="SeatCaption1" width="112" height="56" text="{#setup.seat2}" fontSize="22" verticalAlign="Center" textColor="190,196,190,255" />
                        <element type="UISegmented" name="SeatKind1" bind="seatKind1" flex="1" height="56" direction="Horizontal" spacing="4" color="48,54,72,255">
                          <children>
                            <element type="UIButton" name="Seat1Person" flex="1" height="56" text="{#setup.person}" fontSize="22" action="MahjongSetSeat1" value="person" color="70,70,100,255" selectedColor="40,110,60,255" />
                            <element type="UIButton" name="Seat1Computer" flex="1" height="56" text="{#setup.computer}" fontSize="22" action="MahjongSetSeat1" value="computer" color="70,70,100,255" selectedColor="40,110,60,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UIStack" name="SeatRow2" height="64" direction="Horizontal" spacing="8" padding="4" crossAlign="Stretch" color="48,54,72,255">
                      <children>
                        <element type="UILabel" name="SeatCaption2" width="112" height="56" text="{#setup.seat3}" fontSize="22" verticalAlign="Center" textColor="190,196,190,255" />
                        <element type="UISegmented" name="SeatKind2" bind="seatKind2" flex="1" height="56" direction="Horizontal" spacing="4" color="48,54,72,255">
                          <children>
                            <element type="UIButton" name="Seat2Person" flex="1" height="56" text="{#setup.person}" fontSize="22" action="MahjongSetSeat2" value="person" color="70,70,100,255" selectedColor="40,110,60,255" />
                            <element type="UIButton" name="Seat2Computer" flex="1" height="56" text="{#setup.computer}" fontSize="22" action="MahjongSetSeat2" value="computer" color="70,70,100,255" selectedColor="40,110,60,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UIStack" name="SeatRow3" height="64" direction="Horizontal" spacing="8" padding="4" crossAlign="Stretch" color="48,54,72,255">
                      <children>
                        <element type="UILabel" name="SeatCaption3" width="112" height="56" text="{#setup.seat4}" fontSize="22" verticalAlign="Center" textColor="190,196,190,255" />
                        <element type="UISegmented" name="SeatKind3" bind="seatKind3" flex="1" height="56" direction="Horizontal" spacing="4" color="48,54,72,255">
                          <children>
                            <element type="UIButton" name="Seat3Person" flex="1" height="56" text="{#setup.person}" fontSize="22" action="MahjongSetSeat3" value="person" color="70,70,100,255" selectedColor="40,110,60,255" />
                            <element type="UIButton" name="Seat3Computer" flex="1" height="56" text="{#setup.computer}" fontSize="22" action="MahjongSetSeat3" value="computer" color="70,70,100,255" selectedColor="40,110,60,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UIStack" name="HandsRow" height="64" direction="Horizontal" spacing="8" padding="4" crossAlign="Stretch" color="48,54,72,255">
                      <children>
                        <element type="UILabel" name="HandsCaption" width="112" height="56" text="{#setup.hands}" fontSize="22" verticalAlign="Center" textColor="190,196,190,255" />
                        <element type="UISegmented" name="HandsChoice" bind="handsChoice" flex="1" height="56" direction="Horizontal" spacing="4" color="48,54,72,255">
                          <children>
                            <element type="UIButton" name="Hands16" flex="1" height="56" text="16" fontSize="22" action="MahjongSetHands" value="16" color="70,70,100,255" selectedColor="40,110,60,255" />
                            <element type="UIButton" name="Hands8" flex="1" height="56" text="8" fontSize="22" action="MahjongSetHands" value="8" color="70,70,100,255" selectedColor="40,110,60,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UIStack" name="HintsRow" height="64" direction="Horizontal" spacing="8" padding="4" crossAlign="Stretch" color="48,54,72,255">
                      <children>
                        <element type="UILabel" name="HintsCaption" width="112" height="56" text="{#setup.hints}" fontSize="22" verticalAlign="Center" textColor="190,196,190,255" />
                        <element type="UISegmented" name="HintsChoice" bind="hintsChoice" flex="1" height="56" direction="Horizontal" spacing="4" color="48,54,72,255">
                          <children>
                            <element type="UIButton" name="HintsOn" flex="1" height="56" text="{#setup.on}" fontSize="22" action="MahjongSetHints" value="on" color="70,70,100,255" selectedColor="40,110,60,255" />
                            <element type="UIButton" name="HintsOff" flex="1" height="56" text="{#setup.off}" fontSize="22" action="MahjongSetHints" value="off" color="70,70,100,255" selectedColor="40,110,60,255" />
                          </children>
                        </element>
                      </children>
                    </element>
                    <element type="UIElement" name="StartGap" height="0" />
                    <element type="UIButton" name="Start" height="64" text="{#setup.start}" fontSize="28" action="MahjongStart" color="40,110,60,255" />
                  </children>
                </element>
              </elements>
            </component>
          </components>
        </node>
      </nodes>
    </scene>
  </scenes>
</SceneManager>
