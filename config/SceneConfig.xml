<?xml version="1.0"?>
<SceneManager contentVersion="5">
  <scenes>
    <!--
      The one scene of the game (MahjongGame::GetSceneName()). The view is the design size of the landscape table (kViewWidth x kViewHeight in
      Table/TableLayout.h; MahjongTableUiTest compares the two) and the engine fits it to the window. The shape of the table is picked by
      the aspect of the output (ShapeOfOutput in Table/TableLayout.h, which MahjongSceneFilesTest holds the file to): an output as high
      as it is wide or higher (a phone held upright, a narrow window; a square counts) draws the portrait view, the design size of the
      portrait table (kPortraitViewWidth x kPortraitViewHeight); a landscape output at most kNarrowMaxAspect (1.55) times as wide as high
      (4:3, 3:2, 5:4) draws the narrow view, the design of the narrow table (kNarrowViewWidth x kNarrowViewHeight: the viewer's hand in one
      row with the bonus tiles and melds above it); an output at least kWideMinAspect (2.0) times as wide as high (21:9, 32:9,
      every landscape phone) draws the wide view, the landscape table centred with a wing of kWideWingWidth units on each side (the table is as
      high as before, so the tiles do not grow; the wings are free ground and the felt fills the window). Everything between (16:9, 16:10) draws the landscape view of the scene itself. The views exclude each other.
      The component lays the table out for the active view and the canvases choose their own variants by the same conditions.
      MahjongTableComponent draws the felt, the four hands, the melds, the discards and the wall of the active game, plays the person
      seats and paces the computers.
      Its buttons are the canvases below; the component shows and hides them from the legal actions (Table/ActionButtons.h) and answers
      their actions. MahjongHudComponent publishes the words of the HUD (UIVars), runs the seat choice (the modal canvas Setup) and
      shows the score table of a finished hand (HandOver) and the standings of a finished match (MatchOver).
      The nodes are in config/nodes/, one file per node named Mahjong<Name>; the order of the references below is the draw and input
      order (the engine replaces each reference by the node of its file in the same place).
    -->
    <scene
      type="Scene"
      name="MahjongScene"
      viewWidth="1280"
      viewHeight="720">
      <viewVariants>
        <view name="Portrait" when="orientation:portrait" width="720" height="1280"/>
        <view name="Narrow" when="orientation:landscape;maxAspect:1.55" width="1080" height="768"/>
        <view name="Wide" when="minAspect:2" width="1560" height="720"/>
      </viewVariants>
      <nodes>
        <node ref="nodes/MahjongTable"/>
        <node ref="nodes/MahjongHints"/>
        <node ref="nodes/MahjongHintsButton"/>
        <node ref="nodes/MahjongActions"/>
        <node ref="nodes/MahjongActionsCompact"/>
        <node ref="nodes/MahjongHud"/>
        <node ref="nodes/MahjongSeatPlates"/>
        <node ref="nodes/MahjongCenterPanel"/>
        <node ref="nodes/MahjongHudMenu"/>
        <node ref="nodes/MahjongHintsWhy"/>
        <node ref="nodes/MahjongTileHover"/>
        <node ref="nodes/MahjongHandoff"/>
        <node ref="nodes/MahjongHandOver"/>
        <node ref="nodes/MahjongHandOverAction"/>
        <node ref="nodes/MahjongMatchOver"/>
        <node ref="nodes/MahjongSetup"/>
        <node ref="nodes/MahjongOptions"/>
        <node ref="nodes/MahjongOnline"/>
        <node ref="nodes/MahjongOnlineEntry"/>
        <node ref="nodes/MahjongRules"/>
        <node ref="nodes/MahjongRulesAction"/>
      </nodes>
    </scene>
  </scenes>
</SceneManager>
