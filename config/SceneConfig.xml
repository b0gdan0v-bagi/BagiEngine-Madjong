<?xml version="1.0"?>
<SceneManager>
  <scenes>
    <!-- The one scene of the game (MahjongGame::GetSceneName()). The skeleton shows only its title on a Screen canvas; the table, the tiles and the HUD come with the rules. -->
    <scene
      type="Scene"
      name="MahjongScene">
      <nodes>
        <node name="Hud" layer="10">
          <components>
            <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.7" useSafeArea="true">
              <elements>
                <element type="UILabel" name="Title" anchor="Center" width="90%" maxWidth="480" height="88" text="Mahjong" fontSize="56" align="Center" verticalAlign="Center" />
              </elements>
            </component>
          </components>
        </node>
      </nodes>
    </scene>
  </scenes>
</SceneManager>
