<?xml version="1.0"?>
<!--
  The button HintButton (action MahjongHintAdvice, neutral, hidden until the component shows it) of the hints. It has a node of its own
  because the canvas Hints is a SceneView canvas, which the table's fit scales, so a button there is under the touch minimum in a small
  window. HintsButton is the same canvas as Hints with the same regions: the button fills the region table.hintButton, the left end of
  the strip under the waiting row, and the label AdviceText of Hints lies right of it. MahjongTableComponent shows it exactly where
  Actions is shown and hides it where ActionsCompact is, which holds a HintButton of its own in its row. MahjongHintsComponent shows
  and hides the element by name, so both follow. It comes after Hints (layer 6) so that it lies over the label's plate.
-->
<node name="HintsButton" layer="6" contentVersion="4">
  <components>
    <component type="UICanvasComponent" space="SceneView">
      <elements>
        <element type="UIElement" name="HintButton" region="table.hintButton" anchor="Stretch" visible="false" fontSize="22" color="70,70,100,255">
          <components>
            <component type="UITextComponent" text="{#hints.adviseButton}" align="Center" verticalAlign="Center" wrap="false"/>
            <component type="UIInputClicker" action="MahjongHintAdvice"/>
          </components>
        </element>
      </elements>
    </component>
  </components>
</node>
