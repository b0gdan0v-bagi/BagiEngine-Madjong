<?xml version="1.0"?>
<!--
  Three round icon buttons of 56 units in the top right corner of the window, 8 apart (a row of 184), the tooltip of each says what it does:
  Rules (MahjongRules, opens the pages of the rules from the table), Options (MahjongOptions, opens the page Options) and, in the corner,
  NewGame (MahjongNewGame, opens Setup; its tooltip is the variable newGameWord, "Leave room" in an online room; the element keeps its
  name and its action, so the control API and the tests find it). Each is composed as the engine's icon-only form: the button (a clicker
  and a tooltip, the neutral skin for Rules and Options, the secondary one for NewGame) and its child <Name>Icon, the picture Icon_<...>
  of TextureLibrary.xml (tools/make_icons.py), white and tinted by nothing. No text, so no word is cut by a size. The row ends 192 from the
  right edge, as the Options button did, so the top bonus row of the top seat stays clear of it (TableLayoutTest). A Screen canvas with a
  floor on its scale (minScale 0.6: the 56 unit buttons are 33.6 px), so they are touch targets in any window. Why not regions of the
  table like the other canvases of the table: the canvas scale differs from the table's fit, and the landscape and wide places are corners
  of the window, not of the table, so a region cannot hold them; the two variants that use the table's free ground (portrait, narrow) are
  placed by units of this canvas and MahjongHudTest and MahjongTouchSizeTest hold them clear of every tile on the size matrix (with insets
  they lie nearer the table, as the HUD does). Hidden by the component while HandOver or Rules is shown; MatchOver, Setup and Options are
  Screen canvases whose dim covers the whole window, so the buttons stay under them.
  Variants, later ones replace earlier: a canvas of at most 440 units wide and a nearly square window (aspect up to 1.1, where
  ActionsCompact may hold the bottom) make a column of the three at the right edge; a narrow window (up to 1.55) puts the row in the
  bottom left corner; a portrait window puts the column at the left edge in the middle. A nearly square window may leave a button over the
  end of the line of moves by a few units; no window of the matrix is that.
-->
<node name="HudMenu" layer="10" contentVersion="5">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.6" useSafeArea="true">
      <elements>
        <element type="UIElement" name="Rules" anchor="TopRight" x="-136" y="8" width="56" height="56" color="70,70,100,255" cornerRadius="28" borderWidth="2" borderColor="140,150,180,255" gradientDirection="Vertical" gradientColor="48,48,72,255" shadow="0,4,8,0,0,0,0,90" highlight="255,255,255,60">
          <components>
            <component type="UIInputClicker" action="MahjongRules"/>
            <component type="UITooltipComponent" text="{#hud.rules}"/>
          </components>
          <children>
            <element type="UIElement" name="RulesIcon" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="Icon_Rules"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIElement" name="Options" anchor="TopRight" x="-72" y="8" width="56" height="56" color="70,70,100,255" cornerRadius="28" borderWidth="2" borderColor="140,150,180,255" gradientDirection="Vertical" gradientColor="48,48,72,255" shadow="0,4,8,0,0,0,0,90" highlight="255,255,255,60">
          <components>
            <component type="UIInputClicker" action="MahjongOptions"/>
            <component type="UITooltipComponent" text="{#hud.options}"/>
          </components>
          <children>
            <element type="UIElement" name="OptionsIcon" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="Icon_Options"/>
              </components>
            </element>
          </children>
        </element>
        <element type="UIElement" name="NewGame" anchor="TopRight" x="-8" y="8" width="56" height="56" color="45,75,120,255" cornerRadius="28" borderWidth="2" borderColor="140,150,180,255" gradientDirection="Vertical" gradientColor="30,52,86,255" shadow="0,4,8,0,0,0,0,90" highlight="255,255,255,60">
          <components>
            <component type="UIInputClicker" action="MahjongNewGame"/>
            <component type="UITooltipComponent" text="{newGameWord}"/>
          </components>
          <children>
            <element type="UIElement" name="NewGameIcon" anchor="Center" width="60%" height="60%" aspectRatio="1">
              <components>
                <component type="UIImageComponent" sprite="Icon_NewGame"/>
              </components>
            </element>
          </children>
        </element>
      </elements>
      <variants>
        <variant when="maxWidth:440">
          <overrides>
            <set element="Options" x="-8" y="72" />
            <set element="Rules" x="-8" y="136" />
          </overrides>
        </variant>
        <variant when="orientation:landscape;maxAspect:1.1">
          <overrides>
            <set element="Options" x="-8" y="72" />
            <set element="Rules" x="-8" y="136" />
          </overrides>
        </variant>
        <variant when="orientation:landscape;minAspect:1.1;maxAspect:1.55">
          <overrides>
            <set element="Rules" anchor="BottomLeft" x="8" y="-8" />
            <set element="Options" anchor="BottomLeft" x="72" y="-8" />
            <set element="NewGame" anchor="BottomLeft" x="136" y="-8" />
          </overrides>
        </variant>
        <variant when="orientation:portrait">
          <overrides>
            <set element="Rules" anchor="Left" x="8" y="-36" />
            <set element="Options" anchor="Left" x="8" y="28" />
            <set element="NewGame" anchor="Left" x="8" y="92" />
          </overrides>
        </variant>
      </variants>
    </component>
  </components>
</node>
