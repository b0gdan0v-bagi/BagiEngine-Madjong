<?xml version="1.0"?>
<!--
  The New game button (MahjongNewGame, opens Setup) in the top right corner of the window and the Rules button (MahjongRules, opens
  the pages of the rules, 92 units wide: the top seat's row of bonus tiles of the worst-case table ends at x 980 and a wider button covers it in a 16:10 window) 8 left of it (under it in a canvas of at most 440 units wide, where both do not fit in a row). A Screen canvas with a floor on its scale
  (minScale 0.6: the 56 unit buttons are 33.6 px), so they are touch targets in any window; MahjongHudTest and MahjongTouchSizeTest check them on the
  size matrix and that they cover no tile in a window without insets. With insets they lie nearer the table, as the HUD does. Hidden by the component while
  HandOver or Rules is shown (HandOver has its own Next hand button in the middle of the window; Rules has a dim that covers only the view). MatchOver and Setup are Screen canvases whose dim
  covers the whole window, so the buttons stay under them.
  In a portrait window the top right corner is the top seat's row of bonus tiles, so there both buttons are 176 wide (one under the other,
  16 apart) at the left edge of the middle of the window, where the portrait table has free ground left of the viewer's discards (x 8..252,
  under the side columns, which end at y 556, to y 1020 in view units; the canvas scale is at most about 1.2 times the table's fit there). It comes after the narrow variant, which it replaces.
  In a narrow window (aspect up to 1.55, the table 1080 x 768) the top right corner is the top seat's row of bonus tiles (x 838..974) and the
  line of moves, so from aspect 1.1 both buttons are 176 wide, one over the other, in the bottom left corner of the window: left of the viewer's
  hand (x 204), under the left seat's columns and the bottom seat plate (y 612), 8 from the edges (the canvas scale is within 12 percent of the
  table's fit there). In a nearly square window (up to 1.1) the bar under the table holds ActionsCompact along the bottom, so there Rules goes
  under New game in the top right corner, as in a canvas of at most 440 units, over the end of the line of moves and the last bonus tile by a
  few units at most (a known deviation of the nearly square window, which no window of the matrix is). The portrait variant comes after them and
  replaces them.
-->
<node name="HudMenu" layer="10" contentVersion="2">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.6" useSafeArea="true">
      <elements>
        <element type="UIElement" name="NewGame" anchor="TopRight" x="-8" y="8" width="176" height="56" fontSize="22" color="45,75,120,255">
          <components>
            <component type="UITextComponent" text="{#hud.newGame}" align="Center" verticalAlign="Center" wrap="false"/>
            <component type="UIInputClicker" action="MahjongNewGame"/>
          </components>
        </element>
        <element type="UIElement" name="Rules" anchor="TopRight" x="-192" y="8" width="92" height="56" fontSize="22" color="45,75,120,255">
          <components>
            <component type="UITextComponent" text="{#hud.rules}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
            <component type="UIInputClicker" action="MahjongRules"/>
          </components>
        </element>
      </elements>
      <variants>
        <variant when="maxWidth:440">
          <overrides>
            <set element="Rules" x="-8" y="72" width="176" />
          </overrides>
        </variant>
        <variant when="orientation:landscape;maxAspect:1.1">
          <overrides>
            <set element="Rules" x="-8" y="72" width="176" />
          </overrides>
        </variant>
        <variant when="orientation:landscape;minAspect:1.1;maxAspect:1.55">
          <overrides>
            <set element="NewGame" anchor="BottomLeft" x="8" y="-72" />
            <set element="Rules" anchor="BottomLeft" x="8" y="-8" width="176" />
          </overrides>
        </variant>
        <variant when="orientation:portrait">
          <overrides>
            <set element="NewGame" anchor="Left" x="8" y="-36" />
            <set element="Rules" anchor="Left" x="8" y="36" width="176" />
          </overrides>
        </variant>
      </variants>
    </component>
  </components>
</node>
