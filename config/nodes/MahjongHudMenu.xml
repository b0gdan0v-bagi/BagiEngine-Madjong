<?xml version="1.0"?>
<!--
  The New game button (MahjongNewGame, opens Setup) in the top right corner of the window and the Options button (MahjongOptions, opens
  the page Options, which has the button to the pages of the rules; 92 units wide so that it covers no bonus tile of the top seat in a
  16:10 window) 8 left of it (under it in a canvas of at most 440 units wide). A Screen canvas with a floor on its scale (minScale 0.6:
  the 56 unit buttons are 33.6 px), so they are touch targets in any window. Why not regions of the table like the other canvases of the
  table: the canvas scale differs from the table's fit, and the landscape and wide places are corners of the window, not of the table,
  so a region cannot hold them; the two variants that use the table's free ground (portrait, narrow) are placed by units of this
  canvas and MahjongHudTest and MahjongTouchSizeTest hold them clear of every tile on the size matrix (with insets they lie nearer the
  table, as the HUD does). Hidden by the component while HandOver or Rules is shown; MatchOver, Setup and Options are Screen canvases
  whose dim covers the whole window, so the buttons stay under them.
  Variants, later ones replace earlier: a canvas of at most 440 units wide and a nearly square window (aspect up to 1.1, where
  ActionsCompact may hold the bottom) put Options under New game; a narrow window (up to 1.55) puts both in the bottom left corner;
  a portrait window puts both, 176 wide, at the left edge in the middle. A nearly square window may leave Options over the end of the
  line of moves by a few units; no window of the matrix is that.
-->
<node name="HudMenu" layer="10" contentVersion="5">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.6" useSafeArea="true">
      <elements>
        <element type="UIElement" name="NewGame" anchor="TopRight" x="-8" y="8" width="176" height="56" fontSize="22" color="45,75,120,255">
          <components>
            <component type="UITextComponent" text="{#hud.newGame}" align="Center" verticalAlign="Center" wrap="false"/>
            <component type="UIInputClicker" action="MahjongNewGame"/>
          </components>
        </element>
        <element type="UIElement" name="Options" anchor="TopRight" x="-192" y="8" width="92" height="56" fontSize="22" color="45,75,120,255">
          <components>
            <component type="UITextComponent" text="{#hud.options}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
            <component type="UIInputClicker" action="MahjongOptions"/>
          </components>
        </element>
      </elements>
      <variants>
        <variant when="maxWidth:440">
          <overrides>
            <set element="Options" x="-8" y="72" width="176" />
          </overrides>
        </variant>
        <variant when="orientation:landscape;maxAspect:1.1">
          <overrides>
            <set element="Options" x="-8" y="72" width="176" />
          </overrides>
        </variant>
        <variant when="orientation:landscape;minAspect:1.1;maxAspect:1.55">
          <overrides>
            <set element="NewGame" anchor="BottomLeft" x="8" y="-72" />
            <set element="Options" anchor="BottomLeft" x="8" y="-8" width="176" />
          </overrides>
        </variant>
        <variant when="orientation:portrait">
          <overrides>
            <set element="NewGame" anchor="Left" x="8" y="-36" />
            <set element="Options" anchor="Left" x="8" y="36" width="176" />
          </overrides>
        </variant>
      </variants>
    </component>
  </components>
</node>
