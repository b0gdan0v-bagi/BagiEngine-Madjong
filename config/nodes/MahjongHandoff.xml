<?xml version="1.0"?>
<!--
  The cover of a hot seat: shown by the component exactly while the screen waits for the next person (HandoffPending). A Screen canvas that keeps its buttons touch targets in any window.
  Motion (UiPalette.h kMotion*): fades and rises from 0.96 over 0.18 s, leaves in 0.12 s; _transitionInput stays off (Reveal is not clicked blind). The table draws no hand under the cover, so the fade shows none.
-->
<node name="Handoff" layer="20" contentVersion="5">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.7" useSafeArea="true" modal="true" transitionDuration="0.18" transitionHideDuration="0.12" transitionEase="QuadOut" transitionScaleFrom="0.96" visible="false">
      <elements>
        <element type="UIElement" name="Dim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,200" blocksInput="true" />
        <element type="UIStack" name="Plate" anchor="Center" width="94%" maxWidth="560" height="208" direction="Vertical" spacing="16" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true" cornerRadius="16" borderWidth="2" borderColor="78,86,116,255" gradientDirection="Vertical" gradientColor="26,29,38,255" shadow="0,4,8,0,0,0,0,90" highlight="255,255,255,60">
          <children>
            <element type="UIElement" name="HandoffText" height="96" fontSize="28" color="58,66,92,255" cornerRadius="12" gradientDirection="Vertical" gradientColor="42,48,68,255" highlight="255,255,255,60">
              <components>
                <component type="UITextComponent" fontFamily="Russo One" textOutline="2,16,18,26,255" text="{#cover.text}" align="Center" verticalAlign="Center"/>
              </components>
            </element>
            <element type="UIElement" name="Reveal" height="64" fontSize="28" color="40,110,60,255" cornerRadius="12" borderWidth="2" borderColor="140,150,180,255" gradientDirection="Vertical" gradientColor="26,78,40,255" shadow="0,4,8,0,0,0,0,90" highlight="255,255,255,60">
              <components>
                <component type="UITextComponent" fontFamily="PT Sans" fontWeight="700" text="{#cover.show}" align="Center" verticalAlign="Center" wrap="false"/>
                <component type="UIInputClicker" action="MahjongReveal"/>
              </components>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
