<?xml version="1.0"?>
<!--
  The HUD lies in the free parts of the table: the line of the last move and the name of the selected tile. Both are labels only (not a touch
  target), on the view of the table, and each fills a free region that config/TableLayout.xml gives its shape (Table/TableRegions.h), so
  where it lies in the landscape, portrait, narrow and wide table, and what it stays clear of, is the file's, and there is no variant here.
  A region wins over the safe area: the table is a fixed design that the safe area does not move, so on a screen with a notch or side insets
  the labels stay where they are, like the tiles. The New game button is in the node HudMenu, a Screen canvas, because a control of a
  SceneView canvas is only 21 px high in a small window.
  MoveLine (region table.moveLine) holds the last move in words, right of the top discards (its text fills what the plate leaves inside its
  padding, so the tall portrait region holds more lines).
  SelectedTile (region table.selectedTile) is the name of the tile selected by a tap, above the viewer's hand; MahjongTableComponent
  publishes selectedTileText and shows it while a tile is selected. MahjongHudComponent publishes lastMove (the round, the wall and the
  seats' winds and points are in the node CenterPanel, the seats' names in SeatPlates). MahjongHudTest holds the worst texts and checks that
  each label lies in its region and that no tile of any game lies under it.
-->
<node name="Hud" layer="10" contentVersion="2">
  <components>
    <component type="MahjongHudComponent" />
    <component type="UICanvasComponent" space="SceneView">
      <elements>
        <!-- The last move in words (lastMove), shown by the component exactly while it has a text -->
        <element type="UIStack" name="MoveLine" region="table.moveLine" anchor="Stretch" visible="false" direction="Vertical" padding="8" crossAlign="Stretch" color="10,30,22,170">
          <children>
            <element type="UILabel" name="MoveText" flex="1" text="{lastMove}" fontSize="18" verticalAlign="Center" />
          </children>
        </element>
        <!-- The name of the tile selected by a tap (selectedTileText, Table/TapSelect.h), shown by MahjongTableComponent exactly while a tile is selected -->
        <element type="UIStack" name="SelectedTile" region="table.selectedTile" anchor="Stretch" visible="false" direction="Vertical" padding="8" crossAlign="Stretch" color="10,30,22,170">
          <children>
            <element type="UILabel" name="SelectedTileLabel" flex="1" text="{selectedTileText}" fontSize="18" overflow="AutoFit" align="Center" verticalAlign="Center" />
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
