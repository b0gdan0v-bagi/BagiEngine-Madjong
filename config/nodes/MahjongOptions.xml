<?xml version="1.0"?>
<!--
  The page of what a player sets once: a modal Screen canvas like Setup (ScaleWithScreen, minScale 0.6), hidden here, layer 31. The
  Options button of HudMenu (MahjongOptions) opens it over the table, which is paused meanwhile; Setup never shows it. MahjongHudComponent
  shows it exactly while MahjongGame::IsOptionsOpen(); Back (MahjongOptionsBack) closes it, and OptionsRules beside it (MahjongRules)
  closes it and opens the pages of the rules, which have no button of their own on the HUD. The rows are the shapes of the rows of Setup: the
  language MahjongSetLanguage (value = the language id, variable language), the hints MahjongSetHints (value off, hints or coach, variable
  hintsChoice, published by MahjongHintsComponent; Coach includes the hints), the speed MahjongSetSpeed (value slow, normal or fast, variable
  speedChoice; the pace of the computers, the flights and the marks of a claim, at once). A row is a node edit: the plate's maximum height grows by 72 for it.
  The level is not here: each computer seat has its own on Setup.
  The roomy shape (a canvas of 1280 x 720 units) is the anatomy of the modal screens: the plate is the safe area at most 376 high
  (32 padding + 48 title band + 3 x 64 rows + 64 ButtonRow + 5 x 8 spacing; BackGap is empty, so the 8 + 8 round it set the buttons 16 apart
  from the rows) and the title, the rows and ButtonRow (Rules and Back, half the width each) share its height by flex weights that come out at 48 / 64 (0.75 / 1) and stop
  growing there (maxHeight). A row has no vertical padding: its caption and its group are 87.5 % of its height and centred, which
  is the 4 padding round a 56 segment of a row of 64. The variant for a canvas of at most 360 units high hides the Title;
  the variant for a canvas of at most 440 units wide takes the whole safe width for the plate and narrows the caption of
  Language (64) and hides the captions of the hints and of the speed, whose three words each need the room (112 and 96 wide elsewhere).
  Every text may shrink (AutoFit, down to 12 units) instead of being cut. MahjongOptionsTest holds the
  shapes, the touch size and the words on the whole size matrix.
-->
<node name="Options" layer="31" contentVersion="5">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.6" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIElement" name="Dim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,200" blocksInput="true" />
        <element type="UIStack" name="Plate" anchor="Center" width="94%" maxWidth="640" height="100%" maxHeight="376" direction="Vertical" spacing="8" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UIElement" name="Title" flex="0.75" maxHeight="48" fontSize="28" color="58,66,92,255">
              <components>
                <component type="UITextComponent" text="{#options.title}" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
              </components>
            </element>
            <element type="UIStack" name="LanguageRow" flex="1" maxHeight="64" direction="Horizontal" spacing="8" padding="4,0,4,0" crossAlign="Center" color="48,54,72,255">
              <children>
                <element type="UIElement" name="LanguageCaption" width="112" height="87.5%" fontSize="22">
                  <components>
                    <component type="UITextComponent" text="{#setup.language}" textColor="190,196,190,255" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                  </components>
                </element>
                <element type="UISegmented" name="Language" bind="language" flex="1" height="87.5%" direction="Horizontal" spacing="4" color="48,54,72,255">
                  <children>
                    <element type="UIElement" name="LanguageEn" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#lang.en}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetLanguage" value="en"/>
                      </components>
                    </element>
                    <element type="UIElement" name="LanguageRu" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#lang.ru}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetLanguage" value="ru"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
            <element type="UIStack" name="HintsRow" flex="1" maxHeight="64" direction="Horizontal" spacing="8" padding="4,0,4,0" crossAlign="Center" color="48,54,72,255">
              <children>
                <element type="UIElement" name="HintsCaption" width="112" height="87.5%" fontSize="22">
                  <components>
                    <component type="UITextComponent" text="{#setup.hints}" textColor="190,196,190,255" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                  </components>
                </element>
                <element type="UISegmented" name="HintsChoice" bind="hintsChoice" flex="1" height="87.5%" direction="Horizontal" spacing="4" color="48,54,72,255">
                  <children>
                    <element type="UIElement" name="HintsOff" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#setup.off}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetHints" value="off"/>
                      </components>
                    </element>
                    <element type="UIElement" name="HintsHints" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#options.hintsHints}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetHints" value="hints"/>
                      </components>
                    </element>
                    <element type="UIElement" name="HintsCoach" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#options.hintsCoach}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetHints" value="coach"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
            <element type="UIStack" name="SpeedRow" flex="1" maxHeight="64" direction="Horizontal" spacing="8" padding="4,0,4,0" crossAlign="Center" color="48,54,72,255">
              <children>
                <element type="UIElement" name="SpeedCaption" width="96" height="87.5%" fontSize="22">
                  <components>
                    <component type="UITextComponent" text="{#options.speed}" textColor="190,196,190,255" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                  </components>
                </element>
                <element type="UISegmented" name="SpeedChoice" bind="speedChoice" flex="1" height="87.5%" direction="Horizontal" spacing="4" color="48,54,72,255">
                  <children>
                    <element type="UIElement" name="SpeedSlow" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#options.speedSlow}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetSpeed" value="slow"/>
                      </components>
                    </element>
                    <element type="UIElement" name="SpeedNormal" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#options.speedNormal}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetSpeed" value="normal"/>
                      </components>
                    </element>
                    <element type="UIElement" name="SpeedFast" flex="1" height="100%" fontSize="22" color="70,70,100,255" selectedColor="40,110,60,255">
                      <components>
                        <component type="UITextComponent" text="{#options.speedFast}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                        <component type="UIInputClicker" action="MahjongSetSpeed" value="fast"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
            <element type="UIElement" name="BackGap" height="0" />
            <element type="UIStack" name="ButtonRow" flex="1" maxHeight="64" direction="Horizontal" spacing="8" crossAlign="Stretch">
              <children>
                <element type="UIElement" name="OptionsRules" flex="1" fontSize="28" color="45,75,120,255">
                  <components>
                    <component type="UITextComponent" text="{#hud.rules}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                    <component type="UIInputClicker" action="MahjongRules"/>
                  </components>
                </element>
                <element type="UIElement" name="Back" flex="1" fontSize="28" color="40,110,60,255">
                  <components>
                    <component type="UITextComponent" text="{#options.back}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                    <component type="UIInputClicker" action="MahjongOptionsBack"/>
                  </components>
                </element>
              </children>
            </element>
          </children>
        </element>
      </elements>
      <variants>
        <variant when="maxHeight:360">
          <overrides>
            <set element="Title" visible="false" />
          </overrides>
        </variant>
        <variant when="maxWidth:440">
          <overrides>
            <set element="Plate" width="100%" />
            <set element="LanguageCaption" width="64" />
            <set element="HintsCaption" visible="false" />
            <set element="SpeedCaption" visible="false" />
          </overrides>
        </variant>
      </variants>
    </component>
  </components>
</node>
