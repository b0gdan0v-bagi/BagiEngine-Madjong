<?xml version="1.0"?>
<!--
  The buttons of the rules screen (MahjongRulesBack, MahjongRulesNext, MahjongRulesClose): an action bar at the bottom of the window,
  a Screen canvas with a floor on its scale (minScale 0.6: the 64 unit buttons are 38.4 px), so they are touch targets in any window,
  set to match 1 (with 0.5 the bar is only 91-113 view units high in a 21:9 or 32:9 window and touches the plate of Rules) and not
  modal (Rules is, and takes every click that the bar does not). The buttons are in a bar and not in the plate because 64 units on the
  view are 24 px in the smallest window and the plate cannot be a Screen canvas. Shown
  and hidden by MahjongHudComponent together with Rules, which also hides Back on the first page and Next on the last (the others
  widen: a hidden element takes no room in a stack). Back and Close are neutral, Next confirms (primary).
-->
<node name="RulesAction" layer="36" contentVersion="5">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="1" minScale="0.6" useSafeArea="true" visible="false">
      <elements>
        <element type="UIElement" name="Bar" anchor="Bottom" width="100%" height="80" color="36,40,52,255" blocksInput="true" gradientDirection="Vertical" gradientColor="26,29,38,255" highlight="255,255,255,60" />
        <element type="UIStack" name="Buttons" anchor="Bottom" y="-8" width="94%" maxWidth="640" height="64" direction="Horizontal" spacing="8" crossAlign="Stretch">
          <children>
            <element type="UIElement" name="RulesBack" flex="1" height="64" fontSize="28" color="70,70,100,255" cornerRadius="12" borderWidth="2" borderColor="140,150,180,255" gradientDirection="Vertical" gradientColor="48,48,72,255" shadow="0,4,8,0,0,0,0,90" highlight="255,255,255,60">
              <components>
                <component type="UITextComponent" fontFamily="PT Sans" fontWeight="700" text="{#rules.back}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="18"/>
                <component type="UIInputClicker" action="MahjongRulesBack"/>
              </components>
            </element>
            <element type="UIElement" name="RulesNext" flex="1" height="64" fontSize="28" color="40,110,60,255" cornerRadius="12" borderWidth="2" borderColor="140,150,180,255" gradientDirection="Vertical" gradientColor="26,78,40,255" shadow="0,4,8,0,0,0,0,90" highlight="255,255,255,60">
              <components>
                <component type="UITextComponent" fontFamily="PT Sans" fontWeight="700" text="{#rules.next}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="18"/>
                <component type="UIInputClicker" action="MahjongRulesNext"/>
              </components>
            </element>
            <element type="UIElement" name="RulesClose" flex="1" height="64" fontSize="28" color="70,70,100,255" cornerRadius="12" borderWidth="2" borderColor="140,150,180,255" gradientDirection="Vertical" gradientColor="48,48,72,255" shadow="0,4,8,0,0,0,0,90" highlight="255,255,255,60">
              <components>
                <component type="UITextComponent" fontFamily="PT Sans" fontWeight="700" text="{#rules.close}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="18"/>
                <component type="UIInputClicker" action="MahjongRulesClose"/>
              </components>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
