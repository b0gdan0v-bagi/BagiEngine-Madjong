<?xml version="1.0"?>
<!--
  The buttons of the rules screen (MahjongRulesBack, MahjongRulesNext, MahjongRulesClose): an action bar at the bottom of the window,
  a Screen canvas with a floor on its scale (minScale 0.6: the 64 unit buttons are 38.4 px), so they are touch targets in any window,
  with the anatomy and the reasons of HandOverAction (match 1, not modal: Rules is, and takes every click that the bar does not). Shown
  and hidden by MahjongHudComponent together with Rules, which also hides Back on the first page and Next on the last (the others
  widen: a hidden element takes no room in a stack). Back and Close are neutral, Next confirms (primary).
-->
<node name="RulesAction" layer="36">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="1" minScale="0.6" useSafeArea="true" visible="false">
      <elements>
        <element type="UIElement" name="Bar" anchor="Bottom" width="100%" height="80" color="36,40,52,255" blocksInput="true" />
        <element type="UIStack" name="Buttons" anchor="Bottom" y="-8" width="94%" maxWidth="640" height="64" direction="Horizontal" spacing="8" crossAlign="Stretch">
          <children>
            <element type="UIButton" name="RulesBack" flex="1" height="64" text="{#rules.back}" fontSize="28" overflow="AutoFit" minFontSize="18" action="MahjongRulesBack" color="70,70,100,255" />
            <element type="UIButton" name="RulesNext" flex="1" height="64" text="{#rules.next}" fontSize="28" overflow="AutoFit" minFontSize="18" action="MahjongRulesNext" color="40,110,60,255" />
            <element type="UIButton" name="RulesClose" flex="1" height="64" text="{#rules.close}" fontSize="28" overflow="AutoFit" minFontSize="18" action="MahjongRulesClose" color="70,70,100,255" />
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
