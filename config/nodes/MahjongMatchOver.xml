<?xml version="1.0"?>
<!--
  The end of the match: the seats by points and the New game button (MahjongNewGame, which opens Setup; its word is the variable newGameWord, "Leave room" in an online room), shown while the match is Finished.
  A 480 px window at the user scale 1.5 is 320 units high (296 with a notch), so the plate is 296: 32 padding + 40 headline band +
  4 x 24 rows + 28 MatchCoachRow (the coach's tally, matchOverCoach; hidden and out of the stack unless it has text) + 64 button + 8 NewGameGap +
  7 x 4 spacing (8 children: the rows lie 4 apart and the button 4 + 8 + 4 = 16 below the last of them). The row has to be paid for inside the
  plate: a label of 22 needs 32 high (30 is the least that fits and is off the 4 grid), so the four rows are of 18 (the first place is still gold).
-->
<node name="MatchOver" layer="25" contentVersion="5">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.7" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIElement" name="Dim" anchor="Stretch" ignoreSafeArea="true" color="0,0,0,200" blocksInput="true" />
        <element type="UIStack" name="Plate" anchor="Center" width="94%" maxWidth="560" height="296" direction="Vertical" spacing="4" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true" cornerRadius="16" borderWidth="2" borderColor="78,86,116,255" gradientDirection="Vertical" gradientColor="26,29,38,255" shadow="0,4,8,0,0,0,0,90" highlight="255,255,255,60">
          <children>
            <element type="UIElement" name="Headline" height="40" fontSize="22" color="58,66,92,255" cornerRadius="12" gradientDirection="Vertical" gradientColor="42,48,68,255" highlight="255,255,255,60">
              <components>
                <component type="UITextComponent" fontFamily="Russo One" textOutline="2,16,18,26,255" text="{matchOverHeadline}" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
              </components>
            </element>
            <element type="UIElement" name="Standing0" height="24" color="48,54,72,255" cornerRadius="8" borderWidth="2" borderColor="78,86,116,255" gradientDirection="Vertical" gradientColor="34,38,52,255">
              <children>
                <element type="UIElement" name="StandingFirst0" anchor="Stretch" visible="false" color="84,74,36,255" cornerRadius="8" borderWidth="2" borderColor="255,214,80,255" />
                <element type="UIStack" name="StandingCells0" anchor="Stretch" direction="Horizontal" spacing="8" padding="8,0,8,0" crossAlign="Center">
                  <children>
                    <element type="UIElement" name="StandingPlace0" width="20" height="20" fontSize="18" color="70,84,128,255" cornerRadius="8">
                      <components>
                        <component type="UITextComponent" fontFamily="Russo One" text="{standingPlace0}" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                    <element type="UIElement" name="StandingName0" flex="1" height="100%" fontSize="18">
                      <components>
                        <component type="UITextComponent" fontFamily="PT Sans" fontWeight="700" text="{standingName0}" align="Left" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                    <element type="UIElement" name="StandingScore0" width="24%" height="100%" fontSize="18">
                      <components>
                        <component type="UITextComponent" fontFamily="Russo One" text="{standingScore0}" align="Right" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
            <element type="UIElement" name="Standing1" height="24" color="48,54,72,255" cornerRadius="8" borderWidth="2" borderColor="78,86,116,255" gradientDirection="Vertical" gradientColor="34,38,52,255">
              <children>
                <element type="UIElement" name="StandingFirst1" anchor="Stretch" visible="false" color="84,74,36,255" cornerRadius="8" borderWidth="2" borderColor="255,214,80,255" />
                <element type="UIStack" name="StandingCells1" anchor="Stretch" direction="Horizontal" spacing="8" padding="8,0,8,0" crossAlign="Center">
                  <children>
                    <element type="UIElement" name="StandingPlace1" width="20" height="20" fontSize="18" color="70,84,128,255" cornerRadius="8">
                      <components>
                        <component type="UITextComponent" fontFamily="Russo One" text="{standingPlace1}" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                    <element type="UIElement" name="StandingName1" flex="1" height="100%" fontSize="18">
                      <components>
                        <component type="UITextComponent" fontFamily="PT Sans" fontWeight="700" text="{standingName1}" align="Left" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                    <element type="UIElement" name="StandingScore1" width="24%" height="100%" fontSize="18">
                      <components>
                        <component type="UITextComponent" fontFamily="Russo One" text="{standingScore1}" align="Right" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
            <element type="UIElement" name="Standing2" height="24" color="48,54,72,255" cornerRadius="8" borderWidth="2" borderColor="78,86,116,255" gradientDirection="Vertical" gradientColor="34,38,52,255">
              <children>
                <element type="UIElement" name="StandingFirst2" anchor="Stretch" visible="false" color="84,74,36,255" cornerRadius="8" borderWidth="2" borderColor="255,214,80,255" />
                <element type="UIStack" name="StandingCells2" anchor="Stretch" direction="Horizontal" spacing="8" padding="8,0,8,0" crossAlign="Center">
                  <children>
                    <element type="UIElement" name="StandingPlace2" width="20" height="20" fontSize="18" color="70,84,128,255" cornerRadius="8">
                      <components>
                        <component type="UITextComponent" fontFamily="Russo One" text="{standingPlace2}" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                    <element type="UIElement" name="StandingName2" flex="1" height="100%" fontSize="18">
                      <components>
                        <component type="UITextComponent" fontFamily="PT Sans" fontWeight="700" text="{standingName2}" align="Left" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                    <element type="UIElement" name="StandingScore2" width="24%" height="100%" fontSize="18">
                      <components>
                        <component type="UITextComponent" fontFamily="Russo One" text="{standingScore2}" align="Right" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
            <element type="UIElement" name="Standing3" height="24" color="48,54,72,255" cornerRadius="8" borderWidth="2" borderColor="78,86,116,255" gradientDirection="Vertical" gradientColor="34,38,52,255">
              <children>
                <element type="UIElement" name="StandingFirst3" anchor="Stretch" visible="false" color="84,74,36,255" cornerRadius="8" borderWidth="2" borderColor="255,214,80,255" />
                <element type="UIStack" name="StandingCells3" anchor="Stretch" direction="Horizontal" spacing="8" padding="8,0,8,0" crossAlign="Center">
                  <children>
                    <element type="UIElement" name="StandingPlace3" width="20" height="20" fontSize="18" color="70,84,128,255" cornerRadius="8">
                      <components>
                        <component type="UITextComponent" fontFamily="Russo One" text="{standingPlace3}" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                    <element type="UIElement" name="StandingName3" flex="1" height="100%" fontSize="18">
                      <components>
                        <component type="UITextComponent" fontFamily="PT Sans" fontWeight="700" text="{standingName3}" align="Left" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                    <element type="UIElement" name="StandingScore3" width="24%" height="100%" fontSize="18">
                      <components>
                        <component type="UITextComponent" fontFamily="Russo One" text="{standingScore3}" align="Right" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
                      </components>
                    </element>
                  </children>
                </element>
              </children>
            </element>
            <element type="UIElement" name="MatchCoachRow" visible="false" height="28" fontSize="18" color="48,54,72,255" cornerRadius="8" borderWidth="2" borderColor="78,86,116,255" gradientDirection="Vertical" gradientColor="34,38,52,255">
              <components>
                <component type="UITextComponent" text="{matchOverCoach}" textColor="190,196,190,255" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12"/>
              </components>
            </element>
            <element type="UIElement" name="NewGameGap" height="8" />
            <element type="UIElement" name="NewGame" height="64" fontSize="28" color="40,110,60,255" cornerRadius="12" borderWidth="2" borderColor="140,150,180,255" gradientDirection="Vertical" gradientColor="26,78,40,255" shadow="0,4,8,0,0,0,0,90" highlight="255,255,255,60">
              <components>
                <component type="UITextComponent" fontFamily="PT Sans" fontWeight="700" text="{newGameWord}" align="Center" verticalAlign="Center" overflow="AutoFit" wrap="false" minFontSize="12"/>
                <component type="UIInputClicker" action="MahjongNewGame"/>
              </components>
            </element>
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
