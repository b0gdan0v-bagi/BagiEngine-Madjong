<?xml version="1.0"?>
<!--
  The action buttons lie in the free ground of the table that config/TableLayout.xml gives each shape (Table/TableRegions.h): the
  stack ActionRow fills the region table.actions (right of the bottom discards and above the viewer's melds in the landscape, wide and
  narrow tables; in the portrait one the band between the viewer's discards and the plate), the label Hint the region table.hint. The
  regions are clear of every tile and plate, which TableLayoutSpecTest and MahjongTableScreenTest check; a region wins over the safe
  area: the table is a fixed design that the safe area does not move, so the buttons stay where they are on a screen with a notch. The
  buttons start hidden: the component shows the ones the person to act can press. They wrap inside the stack, so the region's width
  decides the lines: four 104 wide fit the landscape region (the fullest claim window shows seven, the fullest turn six, the toggle Declare
  as wide as the rest). A button says what it does in a plain word (Table/ActionButtons.h, ButtonSpec::wordKey: the keys button.<Kind> of
  config/UIStrings.xml) and, where it concerns tiles, shows them as pictures: a UIImage child NameTile0..2 on the bottom line (the three
  tiles of a chow, the claimed discard of a pung, kong or mahjong, the tile of a concealed kong or of the upgrade), hidden until the
  component sets its sprite (Tile_<notation> of TextureLibrary.xml) and shows it; a picture takes no input, so a click on it is a click on
  the button.
  A button is 56 view units high (kActionButtonHeight, Table/TouchRegime.h), which is a 32 px touch target from a window of 732 x 412 px;
  the table is a fixed design that the engine scales to the window, so a smaller window has smaller buttons and tiles (a tile is 21 x 28
  units, the 3:4 of an atlas cell). Below that window the component hides this canvas and shows ActionsCompact instead
  (NeedsCompactActions), which holds the same buttons by name on the bar under the table, but only where that bar holds the row at its
  height at that canvas width. In a window that the table fills to the bottom (16:9 below 731 x 411, a short wide one like 1000 x 400, a
  landscape phone) or whose bar is lower than the row (a narrow window like 480 x 360 or 600 x 570) this canvas stays, slightly under 32 px but
  clear of the viewer's hand.
  The label Hint above the row shows the sentence of the button under the pointer ({actionHint}, set by the component in the
  current language from UIElement::hovered and again when the language changes; hidden while there is none). It takes no input, so
  it never eats a click; its region is a gutter or a corner clear of the plates and of the row it explains, and the longer words of a
  translation wrap to its height. A touch screen has no hover.
  The variants are the sizes of the buttons, which are a difference of the size class and not of a place. In a portrait view (720 x 1280)
  the buttons are 68 high (kPortraitActionButtonHeight, Table/TouchRegime.h: the view is 720 wide, so a 68 unit button is 34 pt on a phone of
  360 pt and a touch target without ActionsCompact) and 92 wide (the toggle Declare 124: its word and box need it), so that the fullest claim
  window, seven buttons, is one row of 692 units in the 696 of the region. Where the buttons are under 32 px (a portrait window narrower than
  339 px) ActionsCompact takes over on the bar under the table; the one window of the matrix that keeps this canvas small is 1:1 at 480 px
  (25.5 px: the table fills it to the sides and the bottom, so there is no bar). In a narrow view (1080 x 768, the variant with
  orientation:landscape;maxAspect:1.55) the buttons are 84 wide, so four make a line of the region's 360 and the fullest claim window,
  seven, two lines (the Declare toggle too). The fullest turn, six, is two lines as well, with UpgradeKong 104 wide because "Add to pung"
  does not fit 84; the word of Win is the small size, "Маджонг!" at 22 does not fit 84 in a window of 720 x 480. The wide view (1560 x 720) has
  no variant: its regions are the landscape ones shifted by the wing, and the buttons are as they were. The narrow table is 768 high, so a
  button is 33 px or more in every window from 640 x 480 up and ActionsCompact takes over only in a nearly square window (610 x 600: a bar of
  83 px under the table holds its row).
-->
<node name="Actions" layer="10" contentVersion="4">
  <components>
    <component type="UICanvasComponent" space="SceneView">
      <elements>
        <element type="UILabel" name="Hint" region="table.hint" anchor="Stretch" visible="false" text="{actionHint}" fontSize="18" align="Center" verticalAlign="Center" color="0,0,0,200" />
        <element type="UIStack" name="ActionRow" region="table.actions" anchor="Stretch" direction="Horizontal" spacing="8" wrapChildren="true">
          <children>
          <element type="UIElement" name="Win" visible="false" width="104" height="56" fontSize="22" color="40,110,60,255">
            <components>
              <component type="UITextComponent" text="{#button.Win}" align="Center" verticalAlign="Center" wrap="false"/>
              <component type="UIInputClicker" action="MahjongWin"/>
            </components>
          </element>
          <element type="UIElement" name="Mahjong" visible="false" width="104" height="56" fontSize="18" color="40,110,60,255">
            <components>
              <component type="UITextComponent" text="{#button.ClaimMahjong}" align="Center" verticalAlign="Top" wrap="false"/>
              <component type="UIInputClicker" action="MahjongClaimMahjong"/>
            </components>
            <children>
              <element type="UIImage" name="MahjongTile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
            </children>
          </element>
          <element type="UIElement" name="Pung" visible="false" width="104" height="56" fontSize="18" color="45,75,120,255">
            <components>
              <component type="UITextComponent" text="{#button.ClaimPung}" align="Center" verticalAlign="Top" wrap="false"/>
              <component type="UIInputClicker" action="MahjongClaimPung"/>
            </components>
            <children>
              <element type="UIImage" name="PungTile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
            </children>
          </element>
          <element type="UIElement" name="Kong" visible="false" width="104" height="56" fontSize="18" color="45,75,120,255">
            <components>
              <component type="UITextComponent" text="{#button.ClaimKong}" align="Center" verticalAlign="Top" wrap="false"/>
              <component type="UIInputClicker" action="MahjongClaimKong"/>
            </components>
            <children>
              <element type="UIImage" name="KongTile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
            </children>
          </element>
          <element type="UIElement" name="Chow0" visible="false" width="104" height="56" fontSize="18" color="45,75,120,255">
            <components>
              <component type="UITextComponent" text="{#button.ClaimChow0}" align="Center" verticalAlign="Top" wrap="false"/>
              <component type="UIInputClicker" action="MahjongClaimChow" value="0"/>
            </components>
            <children>
              <element type="UIImage" name="Chow0Tile0" visible="false" anchor="Bottom" x="-23" y="-3" width="21" height="28" />
              <element type="UIImage" name="Chow0Tile1" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
              <element type="UIImage" name="Chow0Tile2" visible="false" anchor="Bottom" x="23" y="-3" width="21" height="28" />
            </children>
          </element>
          <element type="UIElement" name="Chow1" visible="false" width="104" height="56" fontSize="18" color="45,75,120,255">
            <components>
              <component type="UITextComponent" text="{#button.ClaimChow1}" align="Center" verticalAlign="Top" wrap="false"/>
              <component type="UIInputClicker" action="MahjongClaimChow" value="1"/>
            </components>
            <children>
              <element type="UIImage" name="Chow1Tile0" visible="false" anchor="Bottom" x="-23" y="-3" width="21" height="28" />
              <element type="UIImage" name="Chow1Tile1" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
              <element type="UIImage" name="Chow1Tile2" visible="false" anchor="Bottom" x="23" y="-3" width="21" height="28" />
            </children>
          </element>
          <element type="UIElement" name="Chow2" visible="false" width="104" height="56" fontSize="18" color="45,75,120,255">
            <components>
              <component type="UITextComponent" text="{#button.ClaimChow2}" align="Center" verticalAlign="Top" wrap="false"/>
              <component type="UIInputClicker" action="MahjongClaimChow" value="2"/>
            </components>
            <children>
              <element type="UIImage" name="Chow2Tile0" visible="false" anchor="Bottom" x="-23" y="-3" width="21" height="28" />
              <element type="UIImage" name="Chow2Tile1" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
              <element type="UIImage" name="Chow2Tile2" visible="false" anchor="Bottom" x="23" y="-3" width="21" height="28" />
            </children>
          </element>
          <element type="UIElement" name="ConcealedKong0" visible="false" width="104" height="56" fontSize="18" color="70,70,100,255">
            <components>
              <component type="UITextComponent" text="{#button.ConcealedKong0}" align="Center" verticalAlign="Top" wrap="false"/>
              <component type="UIInputClicker" action="MahjongConcealedKong" value="0"/>
            </components>
            <children>
              <element type="UIImage" name="ConcealedKong0Tile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
            </children>
          </element>
          <element type="UIElement" name="ConcealedKong1" visible="false" width="104" height="56" fontSize="18" color="70,70,100,255">
            <components>
              <component type="UITextComponent" text="{#button.ConcealedKong1}" align="Center" verticalAlign="Top" wrap="false"/>
              <component type="UIInputClicker" action="MahjongConcealedKong" value="1"/>
            </components>
            <children>
              <element type="UIImage" name="ConcealedKong1Tile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
            </children>
          </element>
          <element type="UIElement" name="ConcealedKong2" visible="false" width="104" height="56" fontSize="18" color="70,70,100,255">
            <components>
              <component type="UITextComponent" text="{#button.ConcealedKong2}" align="Center" verticalAlign="Top" wrap="false"/>
              <component type="UIInputClicker" action="MahjongConcealedKong" value="2"/>
            </components>
            <children>
              <element type="UIImage" name="ConcealedKong2Tile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
            </children>
          </element>
          <element type="UIElement" name="UpgradeKong" visible="false" width="104" height="56" fontSize="18" color="70,70,100,255">
            <components>
              <component type="UITextComponent" text="{#button.UpgradeKong}" align="Center" verticalAlign="Top" wrap="false"/>
              <component type="UIInputClicker" action="MahjongUpgradeKong"/>
            </components>
            <children>
              <element type="UIImage" name="UpgradeKongTile0" visible="false" anchor="Bottom" y="-3" width="21" height="28" />
            </children>
          </element>
          <element type="UIElement" name="Pass" visible="false" width="104" height="56" fontSize="22" color="90,50,50,255">
            <components>
              <component type="UITextComponent" text="{#button.Pass}" align="Center" verticalAlign="Center" wrap="false"/>
              <component type="UIInputClicker" action="MahjongPass"/>
            </components>
          </element>
          <element type="UIElement" name="Declare" visible="false" width="104" height="56" color="70,70,100,255" layout="Stack" direction="Horizontal" spacing="8" crossAlign="Center">
            <components>
              <component type="UIInputClicker"/>
              <component type="UIToggleComponent" bind="declareNext" action="MahjongDeclare" onValue="on" offValue="off"/>
            </components>
            <children>
              <element type="UIElement" name="DeclareCaption" flex="1" height="100%" fontSize="22">
                <components>
                  <component type="UITextComponent" text="{#button.Declare}" verticalAlign="Center" wrap="false" fadeWhenDisabled="true"/>
                </components>
              </element>
              <element type="UIElement" name="DeclareSwitch" height="100%" aspectRatio="1.25">
                <components>
                  <component type="UISwitchComponent"/>
                </components>
              </element>
            </children>
          </element>
          </children>
        </element>
      </elements>
      <variants>
        <variant when="orientation:portrait">
          <overrides>
            <set element="Win" width="92" height="68" />
            <set element="Mahjong" width="92" height="68" />
            <set element="Pung" width="92" height="68" />
            <set element="Kong" width="92" height="68" />
            <set element="Chow0" width="92" height="68" />
            <set element="Chow1" width="92" height="68" />
            <set element="Chow2" width="92" height="68" />
            <set element="ConcealedKong0" width="92" height="68" />
            <set element="ConcealedKong1" width="92" height="68" />
            <set element="ConcealedKong2" width="92" height="68" />
            <set element="UpgradeKong" width="92" height="68" />
            <set element="Pass" width="92" height="68" />
            <set element="Declare" width="124" height="68" />
          </overrides>
        </variant>
        <variant when="orientation:landscape;maxAspect:1.55">
          <overrides>
            <set element="Win" width="84" fontSize="18" />
            <set element="Mahjong" width="84" />
            <set element="Pung" width="84" />
            <set element="Kong" width="84" />
            <set element="Chow0" width="84" />
            <set element="Chow1" width="84" />
            <set element="Chow2" width="84" />
            <set element="ConcealedKong0" width="84" />
            <set element="ConcealedKong1" width="84" />
            <set element="ConcealedKong2" width="84" />
            <set element="UpgradeKong" width="104" />
            <set element="Pass" width="84" />
            <set element="Declare" width="84" />
          </overrides>
        </variant>
      </variants>
    </component>
  </components>
</node>
