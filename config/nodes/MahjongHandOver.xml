<?xml version="1.0"?>
<!--
  The score table of a finished hand: a modal canvas on the view of the table (a SceneView: 16 lines of the winner, four seats,
  a headline and a summary, text only, no touch target), shown by MahjongHudComponent exactly while the session is in
  HandOver. The component publishes handOverHeadline, handOverSeat0..3, scoreLine0..15 (only the first lines of the winner are
  shown: ScoreLineN is visible when there is a line N), handOverSummary and handOverButton ("Next hand", "Finish match" on the
  last hand); MahjongNextHand settles the hand and deals on. The button is not in this canvas: a control of a SceneView canvas
  is only 24 px high in the smallest window. It is in HandOverAction, a Screen canvas, in the middle of the window, over the empty
  element ButtonGap of this plate (64 high, between the seat rows and the lines: y 334..398 of the view, the middle of the plate and
  of the window). The gap and the two gaps of 8 around it, 80 units, hold the button in every landscape window of the matrix at user scale 1.0 (its
  scale outgrows the table's by 1.41 at most, 56 x 1.41 = 79). To make room for the gap the lines are in four columns of 24% (124 high for the sixteen, AutoFit down to 12 for
  the longest) instead of three of 32% (188).
  All four hands are face up under the table and must stay readable, so nothing lies over them: there is no Dim (a full-window
  scrim would cover them; the plate is opaque and a modal canvas takes every click) and the plate keeps to the middle of the view.
  The hands, melds and bonus tiles of the four seats take the edges of the view (left columns x 8..119, right columns x 1161..1272,
  the top rows y 8..90, the bottom rows y 620..712 at the design size), so the ground left is about x 120..1160 and y 92..616. It holds
  the discard blocks, the wall ring and the seat plates, which the plate covers on purpose while it is up.
  The plate is 1032 wide (x 124..1156, clear of the side columns) and 32 padding + 48 headline band (one line of 28) + 4 x 32 seat
  rows + 64 gap + 124 lines (four columns, 4 rows of 28 with 4 between) + 48 summary band + 7 x 8 spacing (8 children) = 500 units, at
  y -8 from the middle: y 102..602, clear of the top sets and 18 above the bottom row of bonus tiles. The plate has ignoreSafeArea, like the
  table it lies on (a fixed design that ignores the safe area): with side insets in a portrait or square window 1032 units do not fit the
  safe area, and the hands do not move either.
  In a portrait view (720 x 1280, the variant below) the plate is 504 wide (x 108..612, between the columns of the side seats' hands, melds and
  bonus tiles at x 8..101 and 619..712, which run from y 92 to 500). The lines are in two columns of 48% (eight rows, 252 high); the headline
  is a size smaller (22), the seat rows too (18), and the headline and the summary two lines high (72), for the words of the narrow plate. The
  gap is 112 high: the window is as wide as the table or wider than it in a portrait window, so the button, which follows the window's scale,
  outgrows the table's fit by 1.6 at most (the 1:1 window of 480 px, where the floor of the canvas scale holds), and 56 x 1.6 = 90. The plate
  is 724 high and 56 under the middle of the view (y 334..1058), which puts the middle of the gap, 312 under its top, 6 units under the middle of
  the view as in the landscape plate; it ends clear of the viewer's rows (the bonus tiles start at y 1112).
  In a narrow view (1080 x 768, the variant with orientation:landscape;maxAspect:1.55; config/TableLayout.xml, the narrow table) the side seats'
  columns are at x 8..101 and 979..1072 (the bonus tiles are the inner ones), the top rows end at y 81 and the viewer's row of melds and bonus
  tiles starts at y 636, so the plate is 856 wide (x 112..968, 11 and 8 clear of the columns) and keeps its height and its place (y -8 from the
  middle: y 126..626, 10 above the viewer's row); the lines are 24 % of it (198 units, AutoFit down to 12). The button of HandOverAction follows the
  window and stays in the gap: in a narrow window the ratio of its scale to the table's is 1.0 to 1.02, far under the 1.41 the gap holds.
  MahjongEndScreenTest holds the sizes and that no hand, meld or bonus tile of the worst-case table is covered by the plate or the
  button; MahjongTouchSizeTest holds the button against the gap, the plate and the table in every window of the matrix.
-->
<node name="HandOver" layer="25">
  <components>
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIStack" name="Plate" anchor="Center" ignoreSafeArea="true" y="-8" width="1032" height="500" direction="Vertical" spacing="8" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UILabel" name="Headline" height="48" text="{handOverHeadline}" fontSize="28" align="Center" verticalAlign="Center" color="58,66,92,255" />
            <element type="UILabel" name="SeatRow0" height="32" text="{handOverSeat0}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
            <element type="UILabel" name="SeatRow1" height="32" text="{handOverSeat1}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
            <element type="UILabel" name="SeatRow2" height="32" text="{handOverSeat2}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
            <element type="UILabel" name="SeatRow3" height="32" text="{handOverSeat3}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
            <element type="UIElement" name="ButtonGap" height="64" />
            <element type="UIStack" name="Lines" height="124" direction="Horizontal" spacing="4" wrapChildren="true">
              <children>
                <element type="UILabel" name="ScoreLine0" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine0}" fontSize="18" />
                <element type="UILabel" name="ScoreLine1" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine1}" fontSize="18" />
                <element type="UILabel" name="ScoreLine2" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine2}" fontSize="18" />
                <element type="UILabel" name="ScoreLine3" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine3}" fontSize="18" />
                <element type="UILabel" name="ScoreLine4" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine4}" fontSize="18" />
                <element type="UILabel" name="ScoreLine5" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine5}" fontSize="18" />
                <element type="UILabel" name="ScoreLine6" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine6}" fontSize="18" />
                <element type="UILabel" name="ScoreLine7" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine7}" fontSize="18" />
                <element type="UILabel" name="ScoreLine8" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine8}" fontSize="18" />
                <element type="UILabel" name="ScoreLine9" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine9}" fontSize="18" />
                <element type="UILabel" name="ScoreLine10" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine10}" fontSize="18" />
                <element type="UILabel" name="ScoreLine11" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine11}" fontSize="18" />
                <element type="UILabel" name="ScoreLine12" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine12}" fontSize="18" />
                <element type="UILabel" name="ScoreLine13" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine13}" fontSize="18" />
                <element type="UILabel" name="ScoreLine14" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine14}" fontSize="18" />
                <element type="UILabel" name="ScoreLine15" visible="false" width="24%" height="28" overflow="AutoFit" minFontSize="12" text="{scoreLine15}" fontSize="18" />
              </children>
            </element>
            <element type="UILabel" name="Summary" height="48" text="{handOverSummary}" fontSize="18" align="Center" verticalAlign="Center" color="48,54,72,255" textColor="190,196,190,255" />
          </children>
        </element>
      </elements>
      <variants>
        <variant when="orientation:portrait">
          <overrides>
            <set element="Plate" y="56" width="504" height="724" />
            <set element="Headline" height="72" fontSize="22" />
            <set element="SeatRow0" fontSize="18" />
            <set element="SeatRow1" fontSize="18" />
            <set element="SeatRow2" fontSize="18" />
            <set element="SeatRow3" fontSize="18" />
            <set element="ButtonGap" height="112" />
            <set element="Summary" height="72" />
            <set element="Lines" height="252" />
            <set element="ScoreLine0" width="48%" />
            <set element="ScoreLine1" width="48%" />
            <set element="ScoreLine2" width="48%" />
            <set element="ScoreLine3" width="48%" />
            <set element="ScoreLine4" width="48%" />
            <set element="ScoreLine5" width="48%" />
            <set element="ScoreLine6" width="48%" />
            <set element="ScoreLine7" width="48%" />
            <set element="ScoreLine8" width="48%" />
            <set element="ScoreLine9" width="48%" />
            <set element="ScoreLine10" width="48%" />
            <set element="ScoreLine11" width="48%" />
            <set element="ScoreLine12" width="48%" />
            <set element="ScoreLine13" width="48%" />
            <set element="ScoreLine14" width="48%" />
            <set element="ScoreLine15" width="48%" />
          </overrides>
        </variant>
        <variant when="orientation:landscape;maxAspect:1.55">
          <overrides>
            <set element="Plate" width="856" />
          </overrides>
        </variant>
      </variants>
    </component>
  </components>
</node>
