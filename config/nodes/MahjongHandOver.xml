<?xml version="1.0"?>
<!--
  The score table of a finished hand: a modal canvas on the view of the table (a SceneView: 16 lines of the winner, four seats,
  a headline and a summary, text only, no touch target), shown by MahjongHudComponent exactly while the session is in
  HandOver. The component publishes handOverHeadline, handOverSeat0..3, scoreLine0..15 (ScoreLineN is visible when there is a line N),
  handOverSummary, handOverCoach and handOverButton; MahjongNextHand settles the hand and deals on. The button is not in this canvas: a
  control of a SceneView canvas is only 24 px high in the smallest window. It is in HandOverAction, a Screen canvas, in the middle of
  the window, over the empty element ButtonGap of this plate (the middle of the plate and of the window), which is high enough for the
  button at the most that its scale outgrows the table's fit (MahjongTouchSizeTest holds the button against the gap in every window of
  the matrix).
  All four hands are face up under the table and must stay readable, so nothing lies over them: there is no Dim and the plate keeps to
  the ground the hands, melds and bonus tiles leave free. It covers the discard blocks, the wall ring and the seat plates on purpose
  while it is up. MahjongEndScreenTest holds that no hand, meld or bonus tile of the worst-case table is covered by the plate or the
  button.
  The plate is sized in percents of the view, with ignoreSafeArea on it like the table, a fixed design: the landscape view is the base,
  the wide view (wider than the table) keeps the table's width and is centred, the narrow and the portrait views have a variant
  with their own width, height and offset (the portrait one also has two columns of lines, smaller type and a higher ButtonGap, for
  the words of the narrow plate and for the button, which follows the window's scale). HandCoachRow is hidden unless the HUD has text
  for it and then takes no room, so the plate keeps its size.
-->
<node name="HandOver" layer="25" contentVersion="4">
  <components>
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true" modal="true" visible="false">
      <elements>
        <element type="UIStack" name="Plate" anchor="Center" ignoreSafeArea="true" y="-1.111111%" width="80.625%" height="70.555556%" direction="Vertical" spacing="8" padding="16" crossAlign="Stretch" color="36,40,52,255" blocksInput="true">
          <children>
            <element type="UILabel" name="Headline" height="52" text="{handOverHeadline}" fontSize="28" overflow="AutoFit" minFontSize="22" align="Center" verticalAlign="Center" color="58,66,92,255" />
            <element type="UILabel" name="SeatRow0" height="32" text="{handOverSeat0}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
            <element type="UILabel" name="SeatRow1" height="32" text="{handOverSeat1}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
            <element type="UILabel" name="SeatRow2" height="32" text="{handOverSeat2}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
            <element type="UILabel" name="SeatRow3" height="32" text="{handOverSeat3}" fontSize="22" align="Center" verticalAlign="Center" color="48,54,72,255" />
            <element type="UIElement" name="ButtonGap" height="64" />
            <element type="UIStack" name="Lines" height="108" direction="Horizontal" spacing="4" wrapChildren="true">
              <children>
                <element type="UILabel" name="ScoreLine0" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine0}" fontSize="18" />
                <element type="UILabel" name="ScoreLine1" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine1}" fontSize="18" />
                <element type="UILabel" name="ScoreLine2" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine2}" fontSize="18" />
                <element type="UILabel" name="ScoreLine3" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine3}" fontSize="18" />
                <element type="UILabel" name="ScoreLine4" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine4}" fontSize="18" />
                <element type="UILabel" name="ScoreLine5" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine5}" fontSize="18" />
                <element type="UILabel" name="ScoreLine6" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine6}" fontSize="18" />
                <element type="UILabel" name="ScoreLine7" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine7}" fontSize="18" />
                <element type="UILabel" name="ScoreLine8" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine8}" fontSize="18" />
                <element type="UILabel" name="ScoreLine9" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine9}" fontSize="18" />
                <element type="UILabel" name="ScoreLine10" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine10}" fontSize="18" />
                <element type="UILabel" name="ScoreLine11" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine11}" fontSize="18" />
                <element type="UILabel" name="ScoreLine12" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine12}" fontSize="18" />
                <element type="UILabel" name="ScoreLine13" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine13}" fontSize="18" />
                <element type="UILabel" name="ScoreLine14" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine14}" fontSize="18" />
                <element type="UILabel" name="ScoreLine15" visible="false" width="24%" height="24" overflow="AutoFit" minFontSize="12" text="{scoreLine15}" fontSize="18" />
              </children>
            </element>
            <element type="UILabel" name="HandCoachRow" visible="false" height="24" text="{handOverCoach}" fontSize="18" overflow="AutoFit" minFontSize="12" align="Center" verticalAlign="Center" color="48,54,72,255" textColor="190,196,190,255" />
            <element type="UILabel" name="Summary" height="36" text="{handOverSummary}" fontSize="18" align="Center" verticalAlign="Center" color="48,54,72,255" textColor="190,196,190,255" />
          </children>
        </element>
      </elements>
      <variants>
        <variant when="orientation:portrait">
          <overrides>
            <set element="Plate" y="5.3125%" width="65.555556%" height="58.4375%" />
            <set element="Headline" height="72" fontSize="22" />
            <set element="SeatRow0" fontSize="18" />
            <set element="SeatRow1" fontSize="18" />
            <set element="SeatRow2" fontSize="18" />
            <set element="SeatRow3" fontSize="18" />
            <set element="ButtonGap" height="112" />
            <set element="Summary" height="72" />
            <set element="Lines" height="220" />
            <set element="HandCoachRow" height="48" />
            <set element="ScoreLine0" width="48%" />
            <set element="ScoreLine1" width="48%" />
            <set element="ScoreLine2" width="48%" />
            <set element="ScoreLine3" width="48%" />
            <set element="ScoreLine4" width="48%" />
            <set element="ScoreLine5" width="48%" />
            <set element="ScoreLine6" width="48%" />
            <set element="ScoreLine7" width="48%" />
            <set element="ScoreLine8" width="48%" />
            <set element="ScoreLine9" width="48%" />
            <set element="ScoreLine10" width="48%" />
            <set element="ScoreLine11" width="48%" />
            <set element="ScoreLine12" width="48%" />
            <set element="ScoreLine13" width="48%" />
            <set element="ScoreLine14" width="48%" />
            <set element="ScoreLine15" width="48%" />
          </overrides>
        </variant>
        <variant when="minAspect:2">
          <overrides>
            <set element="Plate" width="66.153846%" />
          </overrides>
        </variant>
        <variant when="orientation:landscape;maxAspect:1.55">
          <overrides>
            <set element="Plate" y="-1.041667%" width="77.777778%" height="66.145833%" />
          </overrides>
        </variant>
      </variants>
    </component>
  </components>
</node>
