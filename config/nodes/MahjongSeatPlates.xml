<?xml version="1.0"?>
<!--
  The words of the four seat plates (Table/SeatPlates.h): the seat's number (and You). MahjongTableComponent paints the plate, its turn, its
  dealer bar and the seat's emblem with its rings; the wind and the points of the seat are in the node CenterPanel. By screen position, not
  by seat, so the labels stay at fixed places: 0 bottom, 1 right, 2 top, 3 left (the variables plateName0..3 that MahjongHudComponent
  publishes follow the seat that sits there). Text only, no control.
  A SceneView canvas whose labels name the regions table.plate.0..3 (Table/TableRegions.h, published by the table from the solved layout):
  each label is anchored inside its plate by fractions of the plate, in the lower part of it, centred, under the ring box of the emblem
  (NameBox of Table/SeatPlates.h: 8 in from the sides, 52 down of 80, 24 high on the plate of 152 x 80). The plate has the same shape in
  every view and the phone profile's lifted bottom plate is a region of its own, so there is no variant. A region wins over the safe area:
  the words stay on the plate, which the safe area does not move. Every label is AutoFit, so the worst names shrink in a small window.
-->
<node name="SeatPlates" layer="10" contentVersion="3">
  <components>
    <component type="UICanvasComponent" space="SceneView">
      <elements>
        <element type="UILabel" name="PlateName0" region="table.plate.0" anchorMin="5.3%,65%" anchorMax="94.7%,95%" text="{plateName0}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PlateName1" region="table.plate.1" anchorMin="5.3%,65%" anchorMax="94.7%,95%" text="{plateName1}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PlateName2" region="table.plate.2" anchorMin="5.3%,65%" anchorMax="94.7%,95%" text="{plateName2}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PlateName3" region="table.plate.3" anchorMin="5.3%,65%" anchorMax="94.7%,95%" text="{plateName3}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
      </elements>
    </component>
  </components>
</node>
