<?xml version="1.0"?>
<!--
  The words of the four seat plates (Table/SeatPlates.h): the seat's number (and You), at the rectangles of
  TableLayout::zones.seatPlates (MahjongTableComponent paints the plate, its turn and its dealer bar under them; the wind and the points
  of the seat are in the node CenterPanel). By screen position, not by seat, so the labels stay at fixed places: 0 bottom, 1 right, 2 top,
  3 left (the variables plateName0..3 that MahjongHudComponent publishes follow the seat that sits there). Text only, no control. A
  SceneView canvas whose labels ignore the safe area like Actions: the plates are on the table, so the words stay on them. One label of
  136 x 32 per plate (the plate is 152 x 80 with a padding of 8, at its top): the labels are direct elements of the canvas, because the
  validator checks the children of a stack against the safe area whatever the stack says.
-->
<node name="SeatPlates" layer="10">
  <components>
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true">
      <elements>
        <element type="UILabel" name="PlateName0" anchor="TopLeft" ignoreSafeArea="true" x="84" y="540" width="136" height="32" text="{plateName0}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PlateName1" anchor="TopLeft" ignoreSafeArea="true" x="1020" y="192" width="136" height="32" text="{plateName1}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PlateName2" anchor="TopLeft" ignoreSafeArea="true" x="416" y="104" width="136" height="32" text="{plateName2}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PlateName3" anchor="TopLeft" ignoreSafeArea="true" x="120" y="192" width="136" height="32" text="{plateName3}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
      </elements>
    </component>
  </components>
</node>
