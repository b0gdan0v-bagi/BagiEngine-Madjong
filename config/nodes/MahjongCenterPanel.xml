<?xml version="1.0"?>
<!--
  The words of the centre panel (Table/CenterPanel.h): the round wind with the number of the hand in it, the tiles left in the wall and,
  on each side, the wind letter and the points of the seat that sits there, inside the wall ring (TableLayout::zones.centerPanel,
  x 472..808, y 282..422 in view units; MahjongTableComponent paints its ground, the light of the turn and the mark of the dealer). By
  screen position, not by seat: 0 bottom, 1 right, 2 top, 3 left, so the labels stay put and the variables panelWind0..3 and
  panelScore0..3 that MahjongHudComponent publishes follow the seat that sits there; panelRound and panelWall are whole sentences of the
  string table. Text only, no control. A SceneView canvas whose labels ignore the safe area like SeatPlates: the panel is on the table,
  so the words stay on it. Every label is a direct element of the canvas (the validator checks the children of a stack against the safe
  area whatever the stack says) and lies inside the panel on the grid of 4 (the panel's own top, 282, is off the grid: the labels start at
  284 and end at 420). The top and bottom cells are 328 wide
  and 28 high; the side cells are 104 wide and as high as the middle (72); the round and the wall lie between them. Every label is
  AutoFit, so the worst texts (-9999, the longest round and wall words) shrink in the small windows. MahjongHudTest holds the labels
  inside the panel and clear of every tile.
-->
<node name="CenterPanel" layer="10">
  <components>
    <component type="UICanvasComponent" space="SceneView" useSafeArea="true">
      <elements>
        <element type="UILabel" name="PanelRound" anchor="TopLeft" ignoreSafeArea="true" x="584" y="320" width="112" height="36" text="{panelRound}" fontSize="28" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PanelWall" anchor="TopLeft" ignoreSafeArea="true" x="584" y="356" width="112" height="32" text="{panelWall}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PanelSeat0" anchor="TopLeft" ignoreSafeArea="true" x="476" y="392" width="328" height="28" text="{panelWind0} {panelScore0}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PanelSeat1" anchor="TopLeft" ignoreSafeArea="true" x="700" y="316" width="104" height="72" text="{panelWind1} {panelScore1}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PanelSeat2" anchor="TopLeft" ignoreSafeArea="true" x="476" y="284" width="328" height="28" text="{panelWind2} {panelScore2}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PanelSeat3" anchor="TopLeft" ignoreSafeArea="true" x="476" y="316" width="104" height="72" text="{panelWind3} {panelScore3}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
      </elements>
    </component>
  </components>
</node>
