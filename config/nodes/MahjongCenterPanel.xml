<?xml version="1.0"?>
<!--
  The words of the centre panel (Table/CenterPanel.h): the round wind with the number of the hand in it, the tiles left in the wall and,
  on each side, the wind letter and the points of the seat that sits there, inside the wall ring. MahjongTableComponent paints the panel's
  ground, the light of the turn and the mark of the dealer. By screen position, not by seat: 0 bottom, 1 right, 2 top, 3 left, so the
  labels stay put and the variables panelWind0..3 and panelScore0..3 that MahjongHudComponent publishes follow the seat that sits there;
  panelRound and panelWall are whole sentences of the string table. Text only, no control.
  A SceneView canvas whose labels name the region table.centerPanel (Table/TableRegions.h, the inside of the wall ring, published by the
  table from the solved layout) and lie in it by fractions of it: the top and the bottom cell run across the panel, the side cells are
  a third wide and as high as the middle, the round and the wall lie between them. The panel has the same shape in every view, so there is
  no variant. A region wins over the safe area: the words stay on the panel, which the safe area does not move. Every label is
  AutoFit, so the worst texts (-9999, the longest round and wall words) shrink in the small windows. MahjongHudTest holds the labels inside
  the panel, apart from each other and clear of every tile.
-->
<node name="CenterPanel" layer="10" contentVersion="4">
  <components>
    <component type="UICanvasComponent" space="SceneView">
      <elements>
        <element type="UILabel" name="PanelRound" region="table.centerPanel" anchorMin="33.3%,27%" anchorMax="66.7%,53%" text="{panelRound}" fontSize="28" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PanelWall" region="table.centerPanel" anchorMin="33.3%,53%" anchorMax="66.7%,76%" text="{panelWall}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PanelSeat0" region="table.centerPanel" anchorMin="1%,80%" anchorMax="99%,100%" text="{panelWind0} {panelScore0}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PanelSeat1" region="table.centerPanel" anchorMin="68%,24%" anchorMax="99%,76%" text="{panelWind1} {panelScore1}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PanelSeat2" region="table.centerPanel" anchorMin="1%,0%" anchorMax="99%,20%" text="{panelWind2} {panelScore2}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
        <element type="UILabel" name="PanelSeat3" region="table.centerPanel" anchorMin="1%,24%" anchorMax="32%,76%" text="{panelWind3} {panelScore3}" fontSize="22" align="Center" verticalAlign="Center" overflow="AutoFit" minFontSize="12" />
      </elements>
    </component>
  </components>
</node>
