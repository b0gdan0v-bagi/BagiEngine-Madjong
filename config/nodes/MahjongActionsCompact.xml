<?xml version="1.0"?>
<!--
  The action buttons for the windows where the buttons of Actions would be under the touch minimum and the bar under the table holds
  this row above the bottom inset (Table/TouchRegime.h, NeedsCompactActions). Elsewhere Actions stays, so this row never lies on the
  viewer's hand. The same 13 buttons (equal to Actions by name, action, value, word and picture; MahjongTableScreenTest compares them)
  and the HintButton, which MahjongHintsComponent shows by name where this canvas is shown (the node HintsButton is hidden then). It
  is a Screen canvas because a SceneView canvas is scaled by the table's fit and cannot be made bigger than the table: minScale
  makes a 56 unit button 33.6 px. The row lies at the bottom, on the bar, and keeps to the safe area, so a home bar lifts it.
  The numbers come from constants of Table/TouchRegime.h (CompactScale, kCompact*, CompactRowHeight) and MahjongTableScreenTest
  compares them with this node; MahjongTouchSizeTest holds the row clear of the table and the touch size. The row is as wide as the
  safe area, which a canvas variant cannot see, so the variants take the narrowest safe area (82 % of the canvas) and give the height
  of the lines the claim window needs when its buttons wrap (TouchRegimeTest wraps the claim window and the turn against them). No
  Hint label: a touch screen has no hover.
-->
<node name="ActionsCompact" layer="10" contentVersion="5">
  <components>
    <component type="UICanvasComponent" space="Screen" scaleMode="ScaleWithScreen" referenceWidth="1280" referenceHeight="720" match="0.5" minScale="0.6" useSafeArea="true" visible="false">
