<?xml version="1.0"?>
<!--
  The card of the coach (Table/HintCard.h, MahjongHintsComponent): in the mode Coach one table in the middle of the table that says either
  the advice of the person's turn with its numbers (MakeAdviceCard, while the switch Hint is on) or the note of the person's last move
  that differs from the computer's choice (MakeNoteCard; the note goes first). Text and tile pictures only, no control: nothing here takes
  input, so a click on it is the table's.
  CoachCard fills the region table.wall (the wall ring of the layout, 364 x 168 in every shape) edge to edge: the one place of the table
  with no hand, meld or discard tile, so it covers only the centre panel (round, wall count, points, the light of the turn) and the wall
  stacks while it is up; the seat plates still show whose turn it is. Its plate is opaque (the palette's surface). Inside the padding
  (8 at the sides, 4 above and below) it is 348 x 160:
  - CardTitle (32, font 22, two lines when it must): {cardTitle}, the sentence of the advice, or "Computer: <advice>" for a note;
  - CardHead (16, muted, font 18): {cardNow}, the steps to a ready hand now, over the three cells who / tiles / word (204), then the
    heads of the two number columns (72 each);
  - CardRow0..2 (24 each, font 18): who (64), up to three tile pictures Card<i>Tile<k> (18 x 24, the sprite Tile_<notation> the component
    sets) in 60, the word of the kind (80), the steps after the move ({cardSteps<i>}, its colour set by the component: green closer to
    ready, amber farther) and the unseen tiles that help (72 each); the component gives the row of the computer's choice the surfaceRaised
    fill and the person's move the danger fill;
  - CardFoot0..1 (20, muted, font 18): why in words, then the tally of the coach.
  Hidden rows take no room. Layer 11: over the HUD (10), under the covers and the modal screens (20 and up). A region wins over the safe
  area, so the card stays on the ring. MahjongHintsTest and MahjongCoachTest hold it on the ring, clear of every slot but the wall
  stacks, free of input, and the longest text of every line fitting on the size matrix in both languages.
-->
<node name="HintsWhy" layer="11" contentVersion="3">
  <components>
    <component type="UICanvasComponent" space="SceneView">
      <elements>
        <element type="UIStack" name="CoachCard" region="table.wall" anchor="Stretch" visible="false" direction="Vertical" spacing="0" padding="8,4,8,4" crossAlign="Stretch" color="36,40,52,255">
          <children>
            <element type="UILabel" name="CardTitle" height="32" text="{cardTitle}" fontSize="22" overflow="AutoFit" minFontSize="12" verticalAlign="Center" />
            <element type="UIStack" name="CardHead" visible="false" height="16" direction="Horizontal" spacing="0" crossAlign="Center">
              <children>
                <element type="UILabel" name="CardNow" width="204" height="16" text="{cardNow}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" textColor="190,196,190,255" />
                <element type="UILabel" name="CardStepsHead" width="72" height="16" text="{#hints.card.steps}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" align="Center" textColor="190,196,190,255" />
                <element type="UILabel" name="CardUsefulHead" width="72" height="16" text="{#hints.card.useful}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" align="Center" textColor="190,196,190,255" />
              </children>
            </element>
            <element type="UIStack" name="CardRow0" visible="false" height="24" direction="Horizontal" spacing="0" crossAlign="Center">
              <children>
                <element type="UILabel" name="CardWho0" width="64" height="24" text="{cardWho0}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" textColor="190,196,190,255" />
                <element type="UIStack" name="CardTiles0" width="60" height="24" direction="Horizontal" spacing="0" crossAlign="Center">
                  <children>
                    <element type="UIImage" name="Card0Tile0" visible="false" width="18" height="24" />
                    <element type="UIImage" name="Card0Tile1" visible="false" width="18" height="24" />
                    <element type="UIImage" name="Card0Tile2" visible="false" width="18" height="24" />
                  </children>
                </element>
                <element type="UILabel" name="CardMove0" width="80" height="24" text="{cardMove0}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" />
                <element type="UILabel" name="CardSteps0" width="72" height="24" text="{cardSteps0}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" align="Center" />
                <element type="UILabel" name="CardUseful0" width="72" height="24" text="{cardUseful0}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" align="Center" />
              </children>
            </element>
            <element type="UIStack" name="CardRow1" visible="false" height="24" direction="Horizontal" spacing="0" crossAlign="Center">
              <children>
                <element type="UILabel" name="CardWho1" width="64" height="24" text="{cardWho1}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" textColor="190,196,190,255" />
                <element type="UIStack" name="CardTiles1" width="60" height="24" direction="Horizontal" spacing="0" crossAlign="Center">
                  <children>
                    <element type="UIImage" name="Card1Tile0" visible="false" width="18" height="24" />
                    <element type="UIImage" name="Card1Tile1" visible="false" width="18" height="24" />
                    <element type="UIImage" name="Card1Tile2" visible="false" width="18" height="24" />
                  </children>
                </element>
                <element type="UILabel" name="CardMove1" width="80" height="24" text="{cardMove1}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" />
                <element type="UILabel" name="CardSteps1" width="72" height="24" text="{cardSteps1}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" align="Center" />
                <element type="UILabel" name="CardUseful1" width="72" height="24" text="{cardUseful1}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" align="Center" />
              </children>
            </element>
            <element type="UIStack" name="CardRow2" visible="false" height="24" direction="Horizontal" spacing="0" crossAlign="Center">
              <children>
                <element type="UILabel" name="CardWho2" width="64" height="24" text="{cardWho2}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" textColor="190,196,190,255" />
                <element type="UIStack" name="CardTiles2" width="60" height="24" direction="Horizontal" spacing="0" crossAlign="Center">
                  <children>
                    <element type="UIImage" name="Card2Tile0" visible="false" width="18" height="24" />
                    <element type="UIImage" name="Card2Tile1" visible="false" width="18" height="24" />
                    <element type="UIImage" name="Card2Tile2" visible="false" width="18" height="24" />
                  </children>
                </element>
                <element type="UILabel" name="CardMove2" width="80" height="24" text="{cardMove2}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" />
                <element type="UILabel" name="CardSteps2" width="72" height="24" text="{cardSteps2}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" align="Center" />
                <element type="UILabel" name="CardUseful2" width="72" height="24" text="{cardUseful2}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" align="Center" />
              </children>
            </element>
            <element type="UILabel" name="CardFoot0" height="20" text="{cardFoot0}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" textColor="190,196,190,255" />
            <element type="UILabel" name="CardFoot1" height="20" text="{cardFoot1}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" wrap="false" textColor="190,196,190,255" />
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
