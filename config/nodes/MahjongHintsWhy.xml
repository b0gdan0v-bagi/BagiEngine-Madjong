<?xml version="1.0"?>
<!--
  The reasons of the advice (Table/Hints.h, ReasonLines): up to six lines in a panel that a second press of HintButton opens and a third
  closes (MahjongHintsComponent). Text only, no control: nothing here takes input, so a click on it is the table's.
  WhyPanel fills the region table.wall (the wall ring of the layout, 364 x 168 in every shape) less 4 at the left and the right (margin 4,0,4,0): the
  one place of the table with no hand, meld or discard tile, so it covers only the centre panel (round, wall count, points) and the wall
  stacks while it is open. Its plate is opaque (the palette's surface), so the centre panel does not show through. It is six
  lines of 28 (font 18, AutoFit down to 12) that hold {hintWhy0}..{hintWhy5}, empty ones included. Layer 11: over the HUD (10), under the
  covers and the modal screens (20 and up). A region wins over the safe area, so the panel stays on the ring. MahjongHintsTest holds it inside
  the ring, clear of every slot but the wall stacks, free of input, and every line of the longest text in both languages fitting on the size
  matrix.
  CoachPanel is the note of the coach (Table/Coach.h, MahjongHintsComponent): up to three sentences {coachNote0}..{coachNote2}, each in a
  label of 40 that wraps to two lines (font 18, AutoFit down to 12). It lies inside the region table.centerPanel with the margin 8,4,8,4, so
  that the gold light of the turn on the panel's edge stays visible while the computers move (the note stays up through their turns), and
  is never up with WhyPanel. Opaque plate, text only, no input. MahjongCoachTest holds it.
-->
<node name="HintsWhy" layer="11" contentVersion="3">
  <components>
    <component type="UICanvasComponent" space="SceneView">
      <elements>
        <element type="UIStack" name="WhyPanel" region="table.wall" anchor="Stretch" margin="4,0,4,0" visible="false" direction="Vertical" spacing="0" padding="0" crossAlign="Stretch" color="36,40,52,255">
          <children>
            <element type="UILabel" name="WhyLine0" height="28" text="{hintWhy0}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" />
            <element type="UILabel" name="WhyLine1" height="28" text="{hintWhy1}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" />
            <element type="UILabel" name="WhyLine2" height="28" text="{hintWhy2}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" />
            <element type="UILabel" name="WhyLine3" height="28" text="{hintWhy3}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" />
            <element type="UILabel" name="WhyLine4" height="28" text="{hintWhy4}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" />
            <element type="UILabel" name="WhyLine5" height="28" text="{hintWhy5}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" />
          </children>
        </element>
        <element type="UIStack" name="CoachPanel" region="table.centerPanel" anchor="Stretch" margin="8,4,8,4" visible="false" direction="Vertical" spacing="0" padding="4" crossAlign="Stretch" color="36,40,52,255">
          <children>
            <element type="UILabel" name="CoachLine0" height="40" text="{coachNote0}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" />
            <element type="UILabel" name="CoachLine1" height="40" text="{coachNote1}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" />
            <element type="UILabel" name="CoachLine2" height="40" text="{coachNote2}" fontSize="18" overflow="AutoFit" minFontSize="12" verticalAlign="Center" />
          </children>
        </element>
      </elements>
    </component>
  </components>
</node>
