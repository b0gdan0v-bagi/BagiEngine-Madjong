<?xml version="1.0" encoding="UTF-8"?>
<!-- The colours of the game, by theme. A colour attribute of a node file says color="@role"; the roles are kUiPaletteNames of Table/UiPalette.h
     (a control takes the role of what it does: config/CLAUDE.md, "UI style") and the table roles of Table/TablePalette.h, which the table paints
     itself. Every theme defines every token (MahjongThemesTest holds it). A new colour is a new token in every theme.
     The marks of the table (the gold family, the wind bars, the danger marks, the dealer's red, the veil, the tile shadows) are not tokens: they
     lie on the ivory tiles, which no theme changes, and stay constants of UiPalette.h. The white tints of the scene files stay literal. -->
<UIThemes default="classic">
    <theme id="classic">
        <color name="scrim" value="0,0,0,200"/>
        <color name="surface" value="36,40,52,255"/>
        <color name="surfaceRaised" value="48,54,72,255"/>
        <color name="header" value="58,66,92,255"/>
        <color name="hudPanel" value="10,30,22,170"/>
        <color name="primary" value="40,110,60,255"/>
        <color name="secondary" value="45,75,120,255"/>
        <color name="neutral" value="70,70,100,255"/>
        <color name="danger" value="90,50,50,255"/>
        <color name="text" value="255,255,255,255"/>
        <color name="textMuted" value="190,196,190,255"/>
        <color name="accent" value="255,214,80,255"/>
        <color name="primaryDeep" value="26,78,40,255"/>
        <color name="secondaryDeep" value="30,52,86,255"/>
        <color name="neutralDeep" value="48,48,72,255"/>
        <color name="dangerDeep" value="62,34,34,255"/>
        <color name="surfaceDeep" value="26,29,38,255"/>
        <color name="surfaceRaisedDeep" value="34,38,52,255"/>
        <color name="headerDeep" value="42,48,68,255"/>
        <color name="hudPanelDeep" value="6,20,14,170"/>
        <color name="frame" value="78,86,116,255"/>
        <color name="frameLight" value="140,150,180,255"/>
        <color name="shadow" value="0,0,0,90"/>
        <color name="highlight" value="255,255,255,60"/>
        <color name="outline" value="16,18,26,255"/>
        <color name="glowPrimary" value="90,200,120,160"/>
        <!-- winnerRow: the winner's row (a modal plate, so a gold accent border is allowed); a first place in the standings the same. placeBadge: the badge with the place number. -->
        <color name="winnerRow" value="84,74,36,255"/>
        <color name="placeBadge" value="70,84,128,255"/>
        <!-- The table: the felt and its rim, the lip under the tiles, the rack under the viewer's hand and the seat plates' frame, shadow and highlight
             (the fill of a plate and of the centre panel is hudPanel, its deep end hudPanelDeep). -->
        <color name="felt" value="22,92,62,255"/>
        <color name="feltRim" value="10,46,32,255"/>
        <color name="feltLip" value="54,128,92,255"/>
        <color name="handRack" value="92,62,42,255"/>
        <color name="handRackLip" value="52,34,24,255"/>
        <color name="plateFrame" value="84,138,106,200"/>
        <color name="plateShadow" value="0,0,0,60"/>
        <color name="plateHighlight" value="255,255,255,36"/>
    </theme>
</UIThemes>
