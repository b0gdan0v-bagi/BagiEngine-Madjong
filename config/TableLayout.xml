      <Plate x="0.2851852" y="0.125" w="0.1407407" h="0.1041667"/>  <!-- 308 96 152x80 -->
    </Seat>
    <Seat position="3">
      <Hand x="0.007407407" y="0.2447917" w="0.03425926" h="0.5104167" minTileW="28"/>  <!-- 8 188 37x392 -->
      <Melds x="0.04537037" y="0.234375" w="0.02962963" h="0.53125" minTileW="24"/>  <!-- 49 180 32x408 -->
      <Bonus x="0.0787037" y="0.2447917" w="0.01944445" h="0.1666667" minTileW="16"/>  <!-- 85 188 21x128 -->
