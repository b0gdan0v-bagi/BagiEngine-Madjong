      <Discards x="0.4390625" y="0.13055556" w="0.121875" h="0.23611111"/>  <!-- 562 94 156x170 -->
      <Plate x="0.3125" y="0.13888889" w="0.11875" h="0.11111111"/>  <!-- 400 100 152x80 -->
