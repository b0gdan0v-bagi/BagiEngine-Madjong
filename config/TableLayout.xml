      <Melds x="0.3851852" y="0.828125" w="0.4666667" h="0.05208333" minTileW="30"/>  <!-- 416 636 504x40 -->
      <Bonus x="0.1888889" y="0.8385417" w="0.1777778" h="0.04166667" minTileW="24"/>  <!-- 204 644 192x32 -->
      <Discards x="0.4333333" y="0.5885417" w="0.1333333" h="0.2083333"/>  <!-- 468 452 144x160 -->
      <Plate x="0.07777778" y="0.6927083" w="0.1407407" h="0.1041667"/>  <!-- 84 532 152x80 -->
    </Seat>
    <Seat position="1">
      <Hand x="0.9583333" y="0.2447917" w="0.03425926" h="0.5104167" minTileW="28"/>  <!-- 1035 188 37x392 -->
      <Melds x="0.925" y="0.234375" w="0.02962963" h="0.53125" minTileW="24"/>  <!-- 999 180 32x408 -->
      <Bonus x="0.9018518" y="0.2447917" w="0.01944445" h="0.1666667" minTileW="16"/>  <!-- 974 188 21x128 -->
      <Discards x="0.7462963" y="0.40625" w="0.1481481" h="0.1875"/>  <!-- 806 312 160x144 -->
      <Plate x="0.7481481" y="0.2395833" w="0.1407407" h="0.1041667"/>  <!-- 808 184 152x80 -->
    </Seat>
    <!-- The top Hand starts at x 340, right of the WaitPanel (x 8..328 in this view); the Bonus tiles lie beside it, centred on it. -->
    <Seat position="2">
      <Hand x="0.3148148" y="0.01041667" w="0.4148148" h="0.0546875" minTileW="32"/>  <!-- 340 8 448x42 -->
      <Melds x="0.3111111" y="0.0703125" w="0.3777778" h="0.04166667" minTileW="24"/>  <!-- 336 54 408x32 -->
      <Bonus x="0.7444444" y="0.01041667" w="0.1185185" h="0.0546875" align="center" minTileW="16"/>  <!-- 804 8 128x42; the tiles centre on the hand -->
