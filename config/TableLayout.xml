<!--
  The zones of the table: where tiles may lie, as FRACTIONS of the design view of each shape (Landscape 1280 x 720, Portrait 720 x 1280,
  Narrow 1080 x 768). The size of a tile is not written here: the solver (src/Mahjong/Table/TableSolver.h) takes the largest tile that fits
  the zone for what the rules allow it to hold, so a zone is never too small for its tiles. The comment after a zone gives it in design
  units (x y w x h) as it is after snapping to a quarter unit; the fractions are what counts. The layout is fitted to the real view
  (uniform scale, centred) afterwards. The file is read at the start and again while the game runs (edit and save, or use the Config Editor):
  a file that fails the reader or the check of the table (CheckTableLayoutSpec) is refused and the last good one stays.

  A zone is x, y, w, h, each 0..1. The seats are by screen position: 0 bottom (the viewer), 1 right, 2 top, 3 left.
    Hand, Melds, Bonus  tiles in a line; a zone wider than it is long runs along the width (a row), a taller one along the height (a column
                        of turned tiles, the side seats). The zone holds: Hand 14 tiles, Melds 4 kongs (16 tiles, a gap between melds),
                        Bonus 8 tiles. Attributes:
      align    start | center | end, where the tiles lie across the line when the zone is thicker than a tile (default start);
      spread   true to spread the hand over the zone's length instead of side by side (the viewer's hand in Portrait);
      tile     solve (default) or profile: the width is asked for by the phone profile and clamped (see Phone below);
      minTileW the smallest tile width this zone may solve to: a file that solves smaller is refused (default 0, no minimum).
    Discards            the pile of the seat: rows of 6 tiles, `rows` rows without overlap (default 5); a longer pile squeezes its rows
                        together inside the zone, so a zone never grows.
    Plate               the seat plate (152 x 80); nothing else lies on it and it keeps 4 units clear of every discard block and the wall.
    Wall                the ring of 26 x 12 stacks; the centre panel is the ring inset by one stack.
  Tile sizes follow one rule: width w, height floor(w * 4 / 3).
  A Shape with like="Name" borrows the zones of that shape and lies `inset` (a fraction of its own width) from the left edge (Wide).
  Clearances other files rely on are named next to the zone that keeps them; tests/TableLayoutTest.cpp holds each of them.
-->
<TableLayout>

  <!-- Landscape: 1280 x 720 (16:9, 16:10 and what lies between). -->
  <Shape name="Landscape">
    <!-- The viewer: the Hand rests 8 units above the bottom edge and starts at x 72, under the left melds column (it ends at y 600); the Melds lie
         right of it and end at x 1268, the Bonus row above the hand. The plate lies left of the Discards, above the Bonus row and right of the left
         melds column (it ends at x 91). The Discards lie between the wall ring (ends y 436) and the hand tile that a tap raises (y 632), and
         lie 8 right of SelectedTile of MahjongHud.xml (ends x 536) and 8 left of the action row (x 720). -->
    <Seat position="0">
      <Hand x="0.05625" y="0.9" w="0.525" h="0.08888889" minTileW="48"/>  <!-- 72 648 672x64 -->
      <Melds x="0.596875" y="0.9333333" w="0.39375" h="0.05555556" minTileW="30"/>  <!-- 764 672 504x40 -->
      <Bonus x="0.05625" y="0.85555556" w="0.15" h="0.04444444" minTileW="24"/>  <!-- 72 616 192x32 -->
      <Discards x="0.425" y="0.61388889" w="0.13125" h="0.25694444"/>  <!-- 544 442 168x185 -->
      <Plate x="0.075" y="0.73888889" w="0.11875" h="0.11111111"/>  <!-- 96 532 152x80 -->
    </Seat>
    <!-- The right seat, turned: the columns hand, melds, bonus from the edge inwards. The Bonus starts at y 192, below the move line of the HUD
         (MahjongHud.xml; it ends at y 172 and reaches over this column). The Hand and the Melds end at y 576 and 600: the hand row of the
         phone profile starts at y 608. The Discards start at x 968: the Hint label of MahjongActions.xml ends at x 960, and the block ends at
         y 436, above the action row (y 440). The plate lies right of that label, below the move line and left of the Bonus column. -->
    <Seat position="1">
      <Hand x="0.9609375" y="0.17777778" w="0.0328125" h="0.62222222" minTileW="32"/>  <!-- 1230 128 42x448 -->
      <Melds x="0.92890625" y="0.17777778" w="0.02890625" h="0.65555556" minTileW="28"/>  <!-- 1189 128 37x472 -->
      <Bonus x="0.90703125" y="0.26666667" w="0.01875" h="0.2" minTileW="18"/>  <!-- 1161 192 24x144 -->
      <Discards x="0.75625" y="0.37222222" w="0.14453125" h="0.23333333"/>  <!-- 968 268 185x168 -->
      <Plate x="0.78125" y="0.25" w="0.11875" h="0.11111111"/>  <!-- 1000 180 152x80 -->
    </Seat>
    <!-- The top seat, the squeeze of the table: the Hand starts at x 444, right of the WaitPanel of MahjongHints.xml (x 96..432), and is not
         centred. From y 8 the Hand (46 high), the Melds (32), the Discards (5 rows of 34) and the wall ring (y 268) leave 4 units between them,
         so a taller tile in one of them takes from the others. The Bonus tiles lie in the row of the Melds, right of them, and end at x 988, left
         of the Rules button (x 996), so every unit of meld width takes 8 from them (4 kongs and 8 bonus tiles fill the row). The plate lies below
         the Melds, left of the Discards and 8 right of AdviceText of MahjongHints.xml (it ends at x 392). -->
    <Seat position="2">
      <Hand x="0.346875" y="0.01111111" w="0.39375" h="0.06388889" minTileW="35"/>  <!-- 444 8 504x46 -->
      <Melds x="0.340625" y="0.08055556" w="0.31875" h="0.04444444" minTileW="24"/>  <!-- 436 58 408x32 -->
      <Bonus x="0.665625" y="0.08055556" w="0.10625" h="0.03055556" minTileW="17"/>  <!-- 852 58 136x22 -->
      <Discards x="0.4390625" y="0.13055556" w="0.121875" h="0.23611111"/>  <!-- 562 94 156x170 -->
      <Plate x="0.3125" y="0.13888889" w="0.11875" h="0.11111111"/>  <!-- 400 100 152x80 -->
    </Seat>
    <!-- The left seat, turned, the right one mirrored; the plate lies right of the Bonus column (ends x 119) and above the Discards, and the
         viewer's plate (x 96) right of the Melds column (ends x 91). -->
    <Seat position="3">
      <Hand x="0.00625" y="0.17777778" w="0.0328125" h="0.62222222" minTileW="32"/>  <!-- 8 128 42x448 -->
      <Melds x="0.0421875" y="0.17777778" w="0.02890625" h="0.65555556" minTileW="28"/>  <!-- 54 128 37x472 -->
      <Bonus x="0.07421875" y="0.26666667" w="0.01875" h="0.2" minTileW="18"/>  <!-- 95 192 24x144 -->
      <Discards x="0.096875" y="0.37222222" w="0.14453125" h="0.23333333"/>  <!-- 124 268 185x168 -->
      <Plate x="0.096875" y="0.25" w="0.11875" h="0.11111111"/>  <!-- 124 180 152x80 -->
    </Seat>
    <Wall x="0.3578125" y="0.3722222" w="0.284375" h="0.2333333"/>  <!-- 458 268 364x168 -->

    <!--
      The phone profile: the viewer's side when the window is so small that the desktop hand tile would be under the touch size
      (TableInput::profile). The Hand is one row of 14 tiles side by side from the left of the zone, resting on its bottom; its width is the
      width asked for (48 up to the widest this zone solves, which must be 78) and the zone is as high as that widest tile. The bonus tiles
      and melds lie in a row above the tallest hand tile, right of the plate; the plate is lifted to end where that tile starts; the bottom
      discards sit lower (3 rows, 144 wide: the 24 tile) and squeeze sooner. Everything else is Landscape's.
    -->
    <Phone>
      <Hand x="0.009375" y="0.8444444" w="0.98125" h="0.1444444" align="end" tile="profile"/>  <!-- 12 608 1256x104 -->
      <Melds x="0.3625" y="0.7833334" w="0.39375" h="0.05555556" minTileW="30"/>  <!-- 464 564 504x40 -->
      <Bonus x="0.196875" y="0.7944444" w="0.15" h="0.04444445" minTileW="24"/>  <!-- 252 572 192x32 -->
      <Discards x="0.44375" y="0.6111111" w="0.1125" h="0.1666667" rows="3"/>  <!-- 568 440 144x120 -->
      <Plate x="0.075" y="0.73333333" w="0.11875" h="0.11111111"/>  <!-- 96 528 152x80 -->
    </Phone>
  </Shape>

  <!-- Portrait: 720 x 1280 (a view at least as high as wide). From the top: the top seat, a band (y 140) of the three opponents' Discards with the
       side seats' columns at the edges, a row of three plates (y 308), the wall ring (y 400), the viewer's Discards, then free ground for the
       canvases of the table (config/nodes/), the viewer's plate, Bonus row, Melds row and the Hand at the foot. -->
  <Shape name="Portrait">
    <!-- The viewer: the Hand is one row of 14 tiles spread over the width inside the rim and the rack, resting on the rim; the Melds and Bonus rows
         lie above it, clear of a tile raised by a tap (kSelectedTileRise). The Discards are larger here (the view is 720 wide: a phone shows it small). -->
    <Seat position="0">
      <Hand x="0.01666667" y="0.94375" w="0.9666666" h="0.05" spread="true" minTileW="48"/>  <!-- 12 1208 696x64 -->
      <Melds x="0.01666667" y="0.896875" w="0.7" h="0.03125" minTileW="30"/>  <!-- 12 1148 504x40 -->
      <Bonus x="0.01666667" y="0.86875" w="0.2666667" h="0.025" minTileW="24"/>  <!-- 12 1112 192x32 -->
      <Discards x="0.35" y="0.45625" w="0.3" h="0.1875"/>  <!-- 252 584 216x240 -->
      <Plate x="0.01666667" y="0.803125" w="0.2111111" h="0.0625"/>  <!-- 12 1028 152x80 -->
    </Seat>
    <!-- The side seats: columns at the edges as in Landscape, from the band down; the plates in one row under the blocks. The band is full: the
         columns (98 wide each side), the side blocks (160) and the top block (156) with their gaps fill the 720 units, so the side seats keep the
         sizes they had before the landscape table grew; only the top seat, which has the height, is as large as in Landscape. -->
    <Seat position="1">
      <Hand x="0.9375" y="0.109375" w="0.05138889" h="0.30625" minTileW="28"/>  <!-- 675 140 37x392 -->
      <Melds x="0.8875" y="0.109375" w="0.04444445" h="0.31875" minTileW="24"/>  <!-- 639 140 32x408 -->
      <Bonus x="0.8527778" y="0.109375" w="0.02916667" h="0.1" minTileW="16"/>  <!-- 614 140 21x128 -->
      <Discards x="0.6194444" y="0.109375" w="0.2222222" h="0.1125"/>  <!-- 446 140 160x144 -->
      <Plate x="0.63333333" y="0.240625" w="0.21111111" h="0.0625"/>  <!-- 456 308 152x80 -->
    </Seat>
    <!-- The top seat starts 32 units below the edge, where a phone's status bar sits. The Bonus tiles lie beside the Hand, centred on it. The
         Discards start 8 under the Melds (y 124) and end at y 294, 14 above the plates (they keep 8 clear of a block); the block is 156 wide,
         the room between the side blocks. -->
    <Seat position="2">
      <Hand x="0.05" y="0.025" w="0.7" h="0.0375" minTileW="36"/>  <!-- 36 32 504x48 -->
      <Melds x="0.2166667" y="0.065625" w="0.5666667" h="0.025" minTileW="24"/>  <!-- 156 84 408x32 -->
      <Bonus x="0.76111111" y="0.025" w="0.18888889" h="0.0375" align="center" minTileW="17"/>  <!-- 548 32 136x48; the tiles centre on the hand -->
      <Discards x="0.39166667" y="0.096875" w="0.21666667" h="0.1328125"/>  <!-- 282 124 156x170 -->
      <Plate x="0.39444444" y="0.240625" w="0.21111111" h="0.0625"/>  <!-- 284 308 152x80 -->
    </Seat>
    <Seat position="3">
      <Hand x="0.01111111" y="0.109375" w="0.05138889" h="0.30625" minTileW="28"/>  <!-- 8 140 37x392 -->
      <Melds x="0.06805556" y="0.109375" w="0.04444445" h="0.31875" minTileW="24"/>  <!-- 49 140 32x408 -->
      <Bonus x="0.1180556" y="0.109375" w="0.02916667" h="0.1" minTileW="16"/>  <!-- 85 140 21x128 -->
      <Discards x="0.1583333" y="0.109375" w="0.2222222" h="0.1125"/>  <!-- 114 140 160x144 -->
      <Plate x="0.15555556" y="0.240625" w="0.21111111" h="0.0625"/>  <!-- 112 308 152x80 -->
    </Seat>
    <Wall x="0.2472222" y="0.3125" w="0.5055556" h="0.13125"/>  <!-- 178 400 364x168 -->
  </Shape>

  <!-- Narrow: 1080 x 768 (4:3, 3:2, 5:4). The landscape table with the viewer's side as the phone profile lays it out: the Hand one row resting
       on the rim, the Bonus tiles and Melds in a row of their own above it (the 48 units of height pay for it), clear of a raised tile. -->
  <Shape name="Narrow">
    <!-- The Hand is centred; the Bonus row starts at its left edge and the Melds lie right of it, bottom aligned above the raised tile. The plate
         lies right of the left seat's Melds column (it ends at x 85). -->
    <Seat position="0">
      <Hand x="0.1888889" y="0.90625" w="0.6222222" h="0.08333334" minTileW="48"/>  <!-- 204 696 672x64 -->
      <Melds x="0.3851852" y="0.828125" w="0.4666667" h="0.05208333" minTileW="30"/>  <!-- 416 636 504x40 -->
      <Bonus x="0.1888889" y="0.8385417" w="0.1777778" h="0.04166667" minTileW="24"/>  <!-- 204 644 192x32 -->
      <Discards x="0.41111111" y="0.57552083" w="0.15555556" h="0.24088542"/>  <!-- 444 442 168x185 -->
      <Plate x="0.081481481" y="0.69270833" w="0.14074074" h="0.10416667"/>  <!-- 88 532 152x80 -->
    </Seat>
    <!-- The side columns run from y 180, below the move line of MahjongHud.xml (it ends at y 172), and end at y 604: the buttons of HudMenu lie
         in the bottom left corner from y 612. Their length is what the left column allows (14 and 16 tiles and three gaps in 432), so the right
         one has the same sizes. The Melds column ends at x 1028 and the action row of MahjongActions.xml (x 620..980) lies 15 left of it. -->
    <Seat position="1">
      <Hand x="0.95555556" y="0.23697917" w="0.037037037" h="0.546875" minTileW="30"/>  <!-- 1032 182 40x420 -->
      <Melds x="0.9212963" y="0.234375" w="0.030555556" h="0.55208333" minTileW="25"/>  <!-- 995 180 33x424 -->
      <Bonus x="0.89629630" y="0.24479167" w="0.022222222" h="0.1875" minTileW="18"/>  <!-- 968 188 24x144 -->
      <Discards x="0.71111111" y="0.34895833" w="0.1712963" h="0.21875"/>  <!-- 768 268 185x168 -->
      <Plate x="0.74074074" y="0.234375" w="0.14074074" h="0.10416667"/>  <!-- 800 180 152x80 -->
    </Seat>
    <!-- The top Hand starts at x 340, right of the WaitPanel (x 8..328 in this view); the Bonus tiles lie beside it, centred on it. The Hand
         (46 high), the Melds (32) and the Discards (170) are those of the landscape table. -->
    <Seat position="2">
      <Hand x="0.31481481" y="0.010416667" w="0.4537037" h="0.059895833" minTileW="35"/>  <!-- 340 8 490x46 -->
      <Melds x="0.31111111" y="0.075520833" w="0.37777778" h="0.041666667" minTileW="24"/>  <!-- 336 58 408x32 -->
      <Bonus x="0.77592593" y="0.010416667" w="0.12592593" h="0.059895833" align="center" minTileW="17"/>  <!-- 838 8 136x46; the tiles centre on the hand -->
      <Discards x="0.42777778" y="0.12239583" w="0.14444444" h="0.22135417"/>  <!-- 462 94 156x170 -->
      <Plate x="0.27777778" y="0.125" w="0.14074074" h="0.10416667"/>  <!-- 300 96 152x80 -->
    </Seat>
    <Seat position="3">
      <Hand x="0.0074074074" y="0.23697917" w="0.037037037" h="0.546875" minTileW="30"/>  <!-- 8 182 40x420 -->
      <Melds x="0.048148148" y="0.234375" w="0.030555556" h="0.55208333" minTileW="25"/>  <!-- 52 180 33x424 -->
      <Bonus x="0.081481481" y="0.24479167" w="0.022222222" h="0.1875" minTileW="18"/>  <!-- 88 188 24x144 -->
      <Discards x="0.11111111" y="0.34895833" w="0.1712963" h="0.21875"/>  <!-- 120 268 185x168 -->
      <Plate x="0.11111111" y="0.234375" w="0.14074074" h="0.10416667"/>  <!-- 120 180 152x80 -->
    </Seat>
    <Wall x="0.3314815" y="0.3489583" w="0.337037" h="0.21875"/>  <!-- 358 268 364x168 -->
  </Shape>

  <!-- Wide: the landscape table in a view 1560 wide, a wing of 140 units (140 / 1560) on each side; the table is as high as before. -->
  <Shape name="Wide" like="Landscape" inset="0.08974359"/>
</TableLayout>
