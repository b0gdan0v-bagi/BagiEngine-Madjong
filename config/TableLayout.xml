      <Hand x="0.05625" y="0.9" w="0.525" h="0.08888889" minTileW="48"/>  <!-- 72 648 672x64 -->
      <Melds x="0.596875" y="0.9333333" w="0.39375" h="0.05555556" minTileW="30"/>  <!-- 764 672 504x40 -->
      <Bonus x="0.05625" y="0.8555555" w="0.15" h="0.04444445" minTileW="24"/>  <!-- 72 616 192x32 -->
      <Discards x="0.44375" y="0.6277778" w="0.1125" h="0.2222222"/>  <!-- 568 452 144x160 -->
      <Plate x="0.065625" y="0.7388889" w="0.11875" h="0.1111111"/>  <!-- 84 532 152x80 -->
    </Seat>
    <!-- The right seat, turned: the columns hand, melds, bonus from the edge inwards. The Bonus starts at y 192, below the move line of the HUD
         (MahjongHud.xml; it ends at y 172 and reaches over this column). The Discards start at x 1006: the Hint label of MahjongActions.xml
         ends at x 1000. The plate lies right of that label, below the move line and left of the Bonus column. -->
    <Seat position="1">
      <Hand x="0.9648438" y="0.2277778" w="0.02890625" h="0.5444444" minTileW="28"/>  <!-- 1235 164 37x392 -->
      <Melds x="0.9367188" y="0.2166667" w="0.025" h="0.5666667" minTileW="24"/>  <!-- 1199 156 32x408 -->
      <Bonus x="0.9171875" y="0.2666667" w="0.01640625" h="0.1777778" minTileW="16"/>  <!-- 1174 192 21x128 -->
      <Discards x="0.7859375" y="0.4" w="0.125" h="0.2"/>  <!-- 1006 288 160x144 -->
      <Plate x="0.790625" y="0.2555556" w="0.11875" h="0.1111111"/>  <!-- 1012 184 152x80 -->
    </Seat>
    <!-- The top seat: the Hand starts at x 444, right of the WaitPanel of MahjongHints.xml (x 96..432), and is not centred. The Bonus tiles lie
         in the row of the Melds, right of them, and end at x 988, left of the Rules button (x 996). The plate lies below the Melds and left of the Discards. -->
    <Seat position="2">
      <Hand x="0.346875" y="0.01111111" w="0.35" h="0.05833333" minTileW="32"/>  <!-- 444 8 448x42 -->
      <Melds x="0.340625" y="0.075" w="0.31875" h="0.04444445" minTileW="24"/>  <!-- 436 54 408x32 -->
      <Bonus x="0.671875" y="0.075" w="0.1" h="0.02916667" minTileW="16"/>  <!-- 860 54 128x21 -->
      <Discards x="0.44375" y="0.1277778" w="0.1125" h="0.2222222"/>  <!-- 568 92 144x160 -->
      <Plate x="0.31875" y="0.1333333" w="0.11875" h="0.1111111"/>  <!-- 408 96 152x80 -->
    </Seat>
    <!-- The left seat, turned; the plate lies right of the Bonus column (ends x 106) and above the Discards. -->
    <Seat position="3">
      <Hand x="0.00625" y="0.2277778" w="0.02890625" h="0.5444444" minTileW="28"/>  <!-- 8 164 37x392 -->
      <Melds x="0.03828125" y="0.2166667" w="0.025" h="0.5666667" minTileW="24"/>  <!-- 49 156 32x408 -->
      <Bonus x="0.06640625" y="0.2666667" w="0.01640625" h="0.1777778" minTileW="16"/>  <!-- 85 192 21x128 -->
      <Discards x="0.0890625" y="0.4" w="0.125" h="0.2"/>  <!-- 114 288 160x144 -->
      <Plate x="0.0875" y="0.2555556" w="0.11875" h="0.1111111"/>  <!-- 112 184 152x80 -->
    </Seat>
    <Wall x="0.3578125" y="0.3722222" w="0.284375" h="0.2333333"/>  <!-- 458 268 364x168 -->

    <!--
      The phone profile: the viewer's side when the window is so small that the desktop hand tile would be under the touch size
      (TableInput::profile). The Hand is one row of 14 tiles side by side from the left of the zone, resting on its bottom; its width is the
      width asked for (48 up to the widest this zone solves, which must be 78) and the zone is as high as that widest tile. The bonus tiles
      and melds lie in a row above the tallest hand tile, right of the plate; the plate is lifted to end where that tile starts; the bottom
      discards sit lower (3 rows, 144 wide: the 24 tile) and squeeze sooner. Everything else is Landscape's.
    -->
    <Phone>
      <Hand x="0.009375" y="0.8444444" w="0.98125" h="0.1444444" align="end" tile="profile"/>  <!-- 12 608 1256x104 -->
      <Melds x="0.3625" y="0.7833334" w="0.39375" h="0.05555556" minTileW="30"/>  <!-- 464 564 504x40 -->
      <Bonus x="0.196875" y="0.7944444" w="0.15" h="0.04444445" minTileW="24"/>  <!-- 252 572 192x32 -->
      <Discards x="0.44375" y="0.6111111" w="0.1125" h="0.1666667" rows="3"/>  <!-- 568 440 144x120 -->
      <Plate x="0.065625" y="0.7333333" w="0.11875" h="0.1111111"/>  <!-- 84 528 152x80 -->
    </Phone>
  </Shape>

  <!-- Portrait: 720 x 1280 (a view at least as high as wide). From the top: the top seat, a band (y 140) of the three opponents' Discards with the
       side seats' columns at the edges, a row of three plates (y 308), the wall ring (y 400), the viewer's Discards, then free ground for the
       canvases of the table (config/nodes/), the viewer's plate, Bonus row, Melds row and the Hand at the foot. -->
  <Shape name="Portrait">
    <!-- The viewer: the Hand is one row of 14 tiles spread over the width inside the rim and the rack, resting on the rim; the Melds and Bonus rows
         lie above it, clear of a tile raised by a tap (kSelectedTileRise). The Discards are larger here (the view is 720 wide: a phone shows it small). -->
    <Seat position="0">
      <Hand x="0.01666667" y="0.94375" w="0.9666666" h="0.05" spread="true" minTileW="48"/>  <!-- 12 1208 696x64 -->
      <Melds x="0.01666667" y="0.896875" w="0.7" h="0.03125" minTileW="30"/>  <!-- 12 1148 504x40 -->
      <Bonus x="0.01666667" y="0.86875" w="0.2666667" h="0.025" minTileW="24"/>  <!-- 12 1112 192x32 -->
      <Discards x="0.35" y="0.45625" w="0.3" h="0.1875"/>  <!-- 252 584 216x240 -->
      <Plate x="0.01666667" y="0.803125" w="0.2111111" h="0.0625"/>  <!-- 12 1028 152x80 -->
    </Seat>
    <!-- The side seats: columns at the edges as in Landscape, from the band down; the plates in one row under the blocks. -->
    <Seat position="1">
      <Hand x="0.9375" y="0.109375" w="0.05138889" h="0.30625" minTileW="28"/>  <!-- 675 140 37x392 -->
      <Melds x="0.8875" y="0.109375" w="0.04444445" h="0.31875" minTileW="24"/>  <!-- 639 140 32x408 -->
      <Bonus x="0.8527778" y="0.109375" w="0.02916667" h="0.1" minTileW="16"/>  <!-- 614 140 21x128 -->
      <Discards x="0.6194444" y="0.109375" w="0.2222222" h="0.1125"/>  <!-- 446 140 160x144 -->
      <Plate x="0.6333333" y="0.240625" w="0.2111111" h="0.0625"/>  <!-- 456 308 152x80 -->
    </Seat>
    <!-- The top seat starts 32 units below the edge, where a phone's status bar sits. The Bonus tiles lie beside the Hand, centred on it. -->
    <Seat position="2">
      <Hand x="0.05" y="0.025" w="0.7" h="0.0375" minTileW="36"/>  <!-- 36 32 504x48 -->
      <Melds x="0.2166667" y="0.065625" w="0.5666667" h="0.025" minTileW="24"/>  <!-- 156 84 408x32 -->
      <Bonus x="0.7722222" y="0.025" w="0.1777778" h="0.0375" align="center" minTileW="16"/>  <!-- 556 32 128x48; the tiles centre on the hand -->
      <Discards x="0.4" y="0.109375" w="0.2" h="0.125"/>  <!-- 288 140 144x160 -->
      <Plate x="0.3944444" y="0.240625" w="0.2111111" h="0.0625"/>  <!-- 284 308 152x80 -->
    </Seat>
    <Seat position="3">
      <Hand x="0.01111111" y="0.109375" w="0.05138889" h="0.30625" minTileW="28"/>  <!-- 8 140 37x392 -->
      <Melds x="0.06805556" y="0.109375" w="0.04444445" h="0.31875" minTileW="24"/>  <!-- 49 140 32x408 -->
      <Bonus x="0.1180556" y="0.109375" w="0.02916667" h="0.1" minTileW="16"/>  <!-- 85 140 21x128 -->
      <Discards x="0.1583333" y="0.109375" w="0.2222222" h="0.1125"/>  <!-- 114 140 160x144 -->
      <Plate x="0.1555556" y="0.240625" w="0.2111111" h="0.0625"/>  <!-- 112 308 152x80 -->
    </Seat>
    <Wall x="0.2472222" y="0.3125" w="0.5055556" h="0.13125"/>  <!-- 178 400 364x168 -->
  </Shape>

  <!-- Narrow: 1080 x 768 (4:3, 3:2, 5:4). The landscape table with the viewer's side as the phone profile lays it out: the Hand one row resting
       on the rim, the Bonus tiles and Melds in a row of their own above it (the 48 units of height pay for it), clear of a raised tile. -->
  <Shape name="Narrow">
