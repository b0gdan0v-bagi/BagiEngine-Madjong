{
	"folders": [
		{
			"path": "..",
			"name": "BagiEngine-Madjong"
		}
	],
	"settings": {
		// C/C++ (IntelliSense mode and compile commands come from CMake Tools for the selected preset)
		"C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
		"C_Cpp.default.cppStandard": "c++20",
		"C_Cpp.errorSquiggles": "enabled",
		"C_Cpp.intelliSenseEngine": "default",
		"C_Cpp.enhancedColorization": "enabled",

		// CMake: generator, compiler, build type and build/<preset> come from CMakePresets.json
		"cmake.useCMakePresets": "always",
		"cmake.configureOnOpen": false,
		"cmake.sourceDirectory": "${workspaceFolder}",
		// Meta Generator needs libclang
		"cmake.configureEnvironment": {
			"LIBCLANG_PATH": "/opt/homebrew/opt/llvm/lib"
		},
		"cmake.environment": {
			"LIBCLANG_PATH": "/opt/homebrew/opt/llvm/lib"
		},

		"files.exclude": {
			"**/.git": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/*.swp": true
		},
		"search.exclude": {
			"**/build": true,
			"engine/external": true,
			"**/*.a": true,
			"**/*.lib": true,
			"**/*.dylib": true,
			"**/*.dll": true,
			"**/*.exe": true
		},
		"files.watcherExclude": {
			"**/build/**": true,
			"engine/external/**": true,
			"**/.git/objects/**": true,
			"**/.git/subtree-cache/**": true
		},

		"files.associations": {
			"*.h": "cpp",
			"*.hpp": "cpp",
			"*.ipp": "cpp",
			"CMakeLists.txt": "cmake",
			"*.cmake": "cmake"
		},

		"editor.formatOnSave": false,
		"editor.tabSize": 4,
		"editor.insertSpaces": true,
		"[cpp]": {
			"editor.defaultFormatter": "ms-vscode.cpptools"
		},

		"terminal.integrated.cwd": "${workspaceFolder}",

		"git.enabled": true,
		"git.autofetch": true
	},
	"extensions": {
		"recommendations": [
			"ms-vscode.cpptools",
			"ms-vscode.cmake-tools",
			"twxs.cmake",
			"vadimcn.vscode-lldb"
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug BagiMahjong (CodeLLDB)",
				"type": "lldb",
				"request": "launch",
				"program": "${command:cmake.launchTargetPath}",
				"args": [],
				"cwd": "${workspaceFolder}",
				"preLaunchTask": "CMake: build"
			},
			{
				"name": "Debug BagiMahjong (CodeLLDB) - No Build",
				"type": "lldb",
				"request": "launch",
				"program": "${command:cmake.launchTargetPath}",
				"args": [],
				"cwd": "${workspaceFolder}"
			},
			{
				"name": "Debug BagiMahjong (Windows MSVC)",
				"type": "cppvsdbg",
				"request": "launch",
				"program": "${command:cmake.launchTargetPath}",
				"args": [],
				"stopAtEntry": false,
				"cwd": "${workspaceFolder}",
				"environment": [],
				"console": "integratedTerminal",
				"preLaunchTask": "CMake: build"
			}
		]
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			// "cmake" tasks follow the presets chosen in CMake Tools (Select Configure / Build Preset)
			{
				"type": "cmake",
				"label": "CMake: configure",
				"command": "configure",
				"problemMatcher": [],
				"group": "build"
			},
			{
				"type": "cmake",
				"label": "CMake: build",
				"command": "build",
				"targets": [
					"BagiMahjong"
				],
				"problemMatcher": "$gcc",
				"group": {
					"kind": "build",
					"isDefault": true
				}
			},
			{
				"type": "cmake",
				"label": "CMake: clean rebuild",
				"command": "cleanRebuild",
				"targets": [
					"BagiMahjong"
				],
				"problemMatcher": "$gcc",
				"group": "build"
			}
		]
	}
}
